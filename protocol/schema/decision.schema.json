{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brokerkit.dev/schema/operator/v1/decision.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["expected_revision", "idempotency_key"],
  "properties": {
    "expected_revision": {"type": "integer", "minimum": 1},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 200},
    "decision_reason": {"type": "string", "maxLength": 2000},
    "on_behalf_of": {"type": "string", "maxLength": 200},
    "constraints": {"type": "object", "additionalProperties": false, "properties": {"duration_seconds": {"type": "integer", "minimum": 1}, "max_uses": {"type": "integer", "minimum": 1}}}
  }
}
