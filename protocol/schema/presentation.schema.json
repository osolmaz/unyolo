{
  "$comment": "Generated from protocol/openapi/operator-v1.yaml; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unyolo.io/schema/operator/v1/presentation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "risk",
    "title",
    "target"
  ],
  "properties": {
    "risk": {
      "$ref": "#/$defs/PresentationRisk"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "summary": {
      "type": "string",
      "maxLength": 2000
    },
    "target": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "facts": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/Fact"
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/Warning"
      }
    },
    "plan_hash": {
      "type": "string",
      "maxLength": 128
    }
  },
  "$defs": {
    "Fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "label",
        "value"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "PresentationRisk": {
      "type": "string",
      "enum": [
        "unknown",
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "Warning": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "text"
      ],
      "properties": {
        "severity": {
          "$ref": "#/$defs/PresentationRisk"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    }
  }
}
