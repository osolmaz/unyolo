{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unyolo.io/schema/host-deployment/v1/deployment.schema.json",
  "title": "unYOLO host deployment",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "name", "runtime", "agents", "operators", "components"],
  "properties": {
    "api_version": { "const": "unyolo.io/host-deployment/v1" },
    "name": { "$ref": "#/$defs/name" },
    "installation_digest": { "$ref": "#/$defs/digest" },
    "source_set_digest": { "$ref": "#/$defs/digest" },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest", "signature", "public_key", "activation"],
      "properties": {
        "manifest": { "$ref": "#/$defs/reference" },
        "signature": { "$ref": "#/$defs/reference" },
        "public_key": { "$ref": "#/$defs/reference" },
        "activation": { "$ref": "#/$defs/reference" }
      }
    },
    "agents": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/agent" } },
    "operators": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/operator" } },
    "components": { "type": "array", "minItems": 1, "maxItems": 32, "items": { "$ref": "#/$defs/component" } },
    "integrations": { "type": "array", "maxItems": 32, "items": { "$ref": "#/$defs/integration" } }
  },
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 2048 },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": { "path": { "$ref": "#/$defs/path" }, "sha256": { "$ref": "#/$defs/digest" } }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "client_id", "target", "component_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "client_id": { "$ref": "#/$defs/name" },
        "target": { "$ref": "#/$defs/agent_target" },
        "component_ids": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/name" } }
      }
    },
    "agent_target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "isolation", "account_mode", "unix_user", "home", "shell"],
          "properties": {
            "kind": { "const": "local_account" },
            "isolation": { "enum": ["separate", "reduced"] },
            "account_mode": { "enum": ["managed", "existing", "current"] },
            "unix_user": { "type": "string", "minLength": 1, "maxLength": 64 },
            "home": { "$ref": "#/$defs/path" },
            "shell": { "$ref": "#/$defs/path" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "isolation", "project_directory", "service"],
          "properties": {
            "kind": { "const": "container" },
            "isolation": { "const": "container" },
            "project_directory": { "$ref": "#/$defs/path" },
            "service": { "$ref": "#/$defs/name" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "isolation", "remote_name"],
          "properties": {
            "kind": { "const": "remote" },
            "isolation": { "const": "remote" },
            "remote_name": { "$ref": "#/$defs/name" }
          }
        }
      ]
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "unix_user"],
      "properties": { "id": { "$ref": "#/$defs/name" }, "unix_user": { "type": "string", "minLength": 1, "maxLength": 32 } }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "profile": { "$ref": "#/$defs/reference" },
        "render_metadata": { "$ref": "#/$defs/reference" }
      }
    },
    "integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "agent_id", "profile"],
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "$ref": "#/$defs/name" },
        "agent_id": { "$ref": "#/$defs/name" },
        "profile": { "$ref": "#/$defs/reference" }
      }
    }
  }
}
