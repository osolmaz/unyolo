{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://brokerkit.io/schema/agent/v1/operation.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "id", "broker", "client_id", "idempotency_key", "operation", "target", "arguments", "state", "revision", "created_at", "updated_at", "presentation"],
  "properties": {
    "api_version": {"const": "brokerkit.io/agent/v1"},
    "id": {"type": "string", "minLength": 1, "maxLength": 128},
    "broker": {"type": "string", "minLength": 1, "maxLength": 64},
    "client_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "idempotency_key": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation": {"type": "string", "minLength": 1, "maxLength": 128},
    "target": {"type": "object", "maxProperties": 32},
    "arguments": {"type": "object", "maxProperties": 32},
    "reason": {"type": "string", "maxLength": 512},
    "state": {"enum": ["pending", "approved", "executing", "succeeded", "failed", "denied", "expired", "canceled"]},
    "revision": {"type": "integer", "minimum": 1},
    "approval_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "terminal_at": {"type": "string", "format": "date-time"},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title"],
      "properties": {
        "title": {"type": "string", "minLength": 1, "maxLength": 160},
        "summary": {"type": "string", "maxLength": 500}
      }
    },
    "result": {"type": "object", "maxProperties": 32},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "message": {"type": "string", "minLength": 1, "maxLength": 500}
      }
    }
  }
}
