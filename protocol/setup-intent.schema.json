{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://unyolo.io/protocol/setup-intent.schema.json",
  "title": "unYOLO setup intent V1",
  "type": "object",
  "additionalProperties": false,
  "required": ["api_version", "goal"],
  "properties": {
    "api_version": { "const": "unyolo.io/setup-intent/v1" },
    "goal": {
      "enum": ["command_only", "credential_service", "agent_connection", "complete_local"]
    },
    "credential_service": { "$ref": "#/$defs/credential_service" },
    "agent": { "$ref": "#/$defs/agent" },
    "connection": { "$ref": "#/$defs/connection" },
    "integrations": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/name" }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "goal": { "enum": ["credential_service", "complete_local"] } } },
      "then": { "required": ["credential_service"] },
      "else": { "not": { "required": ["credential_service"] } }
    },
    {
      "if": { "properties": { "goal": { "enum": ["agent_connection", "complete_local"] } } },
      "then": { "required": ["agent", "connection"] },
      "else": {
        "allOf": [
          { "not": { "required": ["agent"] } },
          { "not": { "required": ["connection"] } }
        ]
      }
    },
    {
      "if": { "properties": { "goal": { "const": "command_only" } } },
      "then": { "properties": { "integrations": { "maxItems": 0 } } }
    }
  ],
  "$defs": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9](?:[a-z0-9-]{0,62}[a-z0-9])?$"
    },
    "credential_service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "providers"],
      "properties": {
        "location": { "enum": ["native", "docker"] },
        "providers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/name" }
        }
      }
    },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["location", "connection_name"],
      "properties": {
        "location": { "enum": ["local_account", "container", "remote"] },
        "connection_name": { "$ref": "#/$defs/name" },
        "account": { "$ref": "#/$defs/account" },
        "container": { "$ref": "#/$defs/container" }
      },
      "allOf": [
        {
          "if": { "properties": { "location": { "const": "local_account" } } },
          "then": { "required": ["account"], "not": { "required": ["container"] } }
        },
        {
          "if": { "properties": { "location": { "const": "container" } } },
          "then": { "required": ["container"], "not": { "required": ["account"] } }
        },
        {
          "if": { "properties": { "location": { "const": "remote" } } },
          "then": {
            "allOf": [
              { "not": { "required": ["account"] } },
              { "not": { "required": ["container"] } }
            ]
          }
        }
      ]
    },
    "account": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["current", "existing", "managed"] },
        "name": { "$ref": "#/$defs/name" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "current" } } },
          "then": { "not": { "required": ["name"] } },
          "else": { "required": ["name"] }
        }
      ]
    },
    "container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project_directory", "service"],
      "properties": {
        "project_directory": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "service": { "$ref": "#/$defs/name" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport"],
      "properties": {
        "transport": { "enum": ["local_socket", "tls"] },
        "remote_endpoint": { "type": "string", "format": "uri", "maxLength": 4096 },
        "server_name": { "type": "string", "minLength": 1, "maxLength": 253 }
      },
      "allOf": [
        {
          "if": { "properties": { "transport": { "const": "tls" } } },
          "then": { "required": ["remote_endpoint", "server_name"] },
          "else": {
            "allOf": [
              { "not": { "required": ["remote_endpoint"] } },
              { "not": { "required": ["server_name"] } }
            ]
          }
        }
      ]
    }
  }
}
