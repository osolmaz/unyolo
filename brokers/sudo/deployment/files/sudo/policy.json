{
  "rules": [
    {
      "id": "agent-request-nginx-reload",
      "effect": "request",
      "clients": ["agent"],
      "operations": ["exec.command"],
      "targets": [{ "kind": "user", "name": "root" }],
      "attrs": { "command_id": ["nginx-reload"] },
      "grant_policy": {
        "mode": "window",
        "default_minutes": 60,
        "max_minutes": 10080,
        "request_ttl_minutes": 10,
        "default_max_uses": 25,
        "max_uses": 1000000
      }
    }
  ]
}
