{
  "rules": [
    {
      "id": "deny-main-force-push",
      "effect": "deny",
      "clients": ["*"],
      "operations": ["git.push.force"],
      "targets": [{"kind": "repo", "owner": "*", "name": "*"}],
      "attrs": {
        "refs": ["refs/heads/main"]
      }
    },
    {
      "id": "deny-ref-delete",
      "effect": "deny",
      "clients": ["*"],
      "operations": ["git.ref.delete"],
      "targets": [{"kind": "repo", "owner": "*", "name": "*"}]
    },
    {
      "id": "agent-a-read-brokerkit",
      "effect": "allow",
      "clients": ["agent-a"],
      "operations": ["git.fetch", "repo.metadata.read", "repo.contents.read"],
      "targets": [{"kind": "repo", "owner": "osolmaz", "name": "brokerkit"}]
    },
    {
      "id": "agent-a-advertise-push",
      "effect": "allow",
      "clients": ["agent-a"],
      "operations": ["git.push.advertise"],
      "targets": [{"kind": "repo", "owner": "osolmaz", "name": "brokerkit"}]
    },
    {
      "id": "agent-a-write-lfs",
      "effect": "allow",
      "clients": ["agent-a"],
      "operations": ["git.lfs.write"],
      "targets": [{"kind": "repo", "owner": "osolmaz", "name": "brokerkit"}]
    },
    {
      "id": "agent-a-push-feature-branches",
      "effect": "allow",
      "clients": ["agent-a"],
      "operations": ["git.push.branch_create", "git.push.fast_forward", "git.push.force"],
      "targets": [{"kind": "repo", "owner": "osolmaz", "name": "brokerkit"}],
      "attrs": {
        "refs": ["refs/heads/agent-a/*"]
      }
    },
    {
      "id": "approve-pull-request-create",
      "effect": "request",
      "clients": ["agent-a"],
      "operations": ["pull_request.create"],
      "targets": [{"kind": "repo", "owner": "osolmaz", "name": "brokerkit"}],
      "attrs": {
        "refs": ["refs/heads/agent-a/*"],
        "base_refs": ["refs/heads/main"]
      }
    },
    {
      "id": "approve-admin-merge",
      "effect": "request",
      "clients": ["agent-a"],
      "operations": ["pull_request.merge_admin"],
      "targets": [{"kind": "pull_request", "owner": "osolmaz", "repo": "brokerkit"}],
      "attrs": {"merge_method": ["merge", "squash", "rebase"]}
    },
    {
      "id": "approve-repository-delete",
      "effect": "request",
      "clients": ["agent-a"],
      "operations": ["repo.delete"],
      "targets": [{"kind": "repo", "owner": "osolmaz", "name": "brokerkit-e2e-*"}]
    },
    {
      "id": "approve-repository-secret",
      "effect": "request",
      "clients": ["agent-a"],
      "operations": ["agent_task.create_or_update_repo_secret"],
      "targets": [{"kind": "repo", "owner": "osolmaz", "name": "brokerkit"}]
    },
    {
      "id": "approve-collaborator-administration",
      "effect": "request",
      "clients": ["agent-a"],
      "operations": ["collaborator.repos_add_collaborator", "collaborator.repos_remove_collaborator"],
      "targets": [{"kind": "repo", "owner": "osolmaz", "name": "brokerkit"}]
    }
  ]
}
