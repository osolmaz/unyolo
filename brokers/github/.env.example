GH_BROKER_ENVIRONMENT=local
GH_BROKER_BIND_ADDR=127.0.0.1
GH_BROKER_PORT=8080
GH_BROKER_CLIENT_ID=bob
# Must be at least 32 bytes. Use a generated value, not a human password.
GH_BROKER_SHARED_SECRET=replace-with-at-least-32-random-bytes
# Preferred for service installs: named client secrets file. If set,
# GH_BROKER_SHARED_SECRET can be omitted.
GH_BROKER_SECRETS_FILE=
# Optional development operator inbox. Production setup generates a separate
# named secret file and keeps this credential out of agent environments.
GH_BROKER_OPERATOR_ID=onur
GH_BROKER_OPERATOR_SHARED_SECRET=
GH_BROKER_OPERATOR_SECRETS_FILE=
GH_BROKER_OPERATOR_BIND_ADDR=127.0.0.1
GH_BROKER_OPERATOR_PORT=8082
# Protected-file-only development fallback. This mode is explicitly non-production,
# and doctor fails it in production environments.
GH_BROKER_GITHUB_TOKEN_FILE=./github-token
# Production GitHub App mode replaces the development token above. Keep each
# credential in a protected file and set all three variables together.
# GH_BROKER_GITHUB_APP_ID_FILE=./github-app-id
# GH_BROKER_GITHUB_APP_PRIVATE_KEY_FILE=./github-app-private-key.pem
# GH_BROKER_GITHUB_WEBHOOK_SECRET_FILE=./github-webhook-secret
# Optional, paired GitHub App OAuth credentials enable encrypted user-token setup.
# GH_BROKER_GITHUB_APP_CLIENT_ID_FILE=./github-app-client-id
# GH_BROKER_GITHUB_APP_CLIENT_SECRET_FILE=./github-app-client-secret
# GitHub Enterprise Server deployments may override both base URLs.
GH_BROKER_GITHUB_API_URL=https://api.github.com/
GH_BROKER_GITHUB_WEB_URL=https://github.com/
GH_BROKER_SCOPE_FILE=scope.json
GH_BROKER_STATE_DIR=./state
GH_BROKER_GITHUB_HTTP_TIMEOUT=30
GH_BROKER_MAX_RECEIVE_PACK_BYTES=26214400
# Optional. Set both to enable Telegram notifications for requestable grants.
GH_BROKER_TELEGRAM_BOT_TOKEN=
GH_BROKER_TELEGRAM_CHAT_ID=
