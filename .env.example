CBA_ENVIRONMENT=local
CBA_PORT=8080
# Must be at least 32 bytes. Use a generated value, not a human password.
CBA_SHARED_SECRET=replace-with-at-least-32-random-bytes
# Server-side GitHub credential. Never expose this to clients.
CBA_GITHUB_TOKEN=github_pat_or_fine_grained_token
CBA_GITHUB_ACCESS_FILE=github-access.json
