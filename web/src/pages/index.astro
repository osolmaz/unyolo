---
import { Code } from "astro:components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import AccessDiagram from "../components/AccessDiagram.astro";
import { GITHUB_REPO } from "../config/nav";
import "../styles/landing.css";

const shiki = { light: "github-light", dark: "github-dark" } as const;

const steps = [
  {
    title: "Authenticate the client",
    body: "The caller presents a named broker-client secret. Reaching the broker is not authentication.",
  },
  {
    title: "Classify the request",
    body: "Your adapter reduces an HTTP call, a Git pack, or a command into one client, operation, target, and set of attrs.",
  },
  {
    title: "Evaluate policy",
    body: "The shared engine matches that tuple against your rules file.",
  },
  {
    title: "Check active grants",
    body: "An approved grant acts as a generated allow rule with an expiry and a use budget.",
  },
  {
    title: "Create an approval request",
    body: "A requestable operation waits in the operator inbox, and in Telegram if you enabled it.",
  },
  {
    title: "Execute",
    body: "Only the broker touches the real credential. The client gets the result, never the token.",
  },
  {
    title: "Write the audit entry",
    body: "The decision is recorded with the rule IDs that matched, and without secrets.",
  },
];

const brokers = [
  {
    href: "/docs/brokers/github",
    name: "gh-broker",
    blurb:
      "Holds GitHub App credentials. For a repo-scoped request it mints a short-lived installation token narrowed to that one repository and the minimum permissions the operation needs.",
    ops: ["pull_request.create", "git.push.fast_forward", "contents.read"],
  },
  {
    href: "/docs/brokers/hugging-face",
    name: "hf-broker",
    blurb:
      "Holds a Hugging Face token for Git, LFS, Hub, and Router inference. It parses every push before forwarding it, so a history rewrite is refused at the broker instead of reaching the Hub.",
    ops: ["git.push.append", "repo.contents.read", "bucket.object.write"],
  },
  {
    href: "/docs/brokers/sudo",
    name: "sudo-broker",
    blurb:
      "Runs one exact command from a root-owned catalog as another Unix user. Shell strings, arbitrary executables, TTYs, and caller-supplied environments are all refused.",
    ops: ["exec.command"],
  },
];

const scopeAllow = `{
  "rules": [
    {
      "id": "agent-a-read-and-branch",
      "effect": "allow",
      "clients": ["agent-a"],
      "operations": [
        "contents.read",
        "git.fetch",
        "git.push.fast_forward"
      ],
      "targets": [
        { "kind": "repo", "owner": "acme", "name": "api" }
      ],
      "attrs": {
        "refs": ["refs/heads/agent-a/**"]
      }
    }
  ]
}`;

const scopeRequest = `{
  "rules": [
    {
      "id": "request-force-push-to-main",
      "effect": "request",
      "clients": ["agent-a"],
      "operations": ["git.push.force"],
      "targets": [
        { "kind": "repo", "owner": "acme", "name": "api" }
      ],
      "attrs": {
        "refs": ["refs/heads/main"]
      },
      "grant_policy": {
        "mode": "window",
        "default_minutes": 5,
        "max_minutes": 10,
        "default_max_uses": 1,
        "max_uses": 1
      }
    }
  ]
}`;

const scopeDeny = `{
  "rules": [
    {
      "id": "never-delete-refs",
      "effect": "deny",
      "clients": ["*"],
      "operations": ["git.ref.delete"],
      "targets": [{ "kind": "repo" }],
      "description": "Deletion is never delegated, even under an approved grant."
    }
  ]
}`;

// Terminal transcripts are authored as HTML strings so that JSON braces do not
// have to be escaped for the template compiler.
const agentTranscript = `<span class="t-prompt">$</span> git push origin agent-a/parser-fix
<span class="t-ok">   4d1e07c..9f2c1ab  agent-a/parser-fix -&gt; (new branch)</span>

<span class="t-prompt">$</span> gh-broker operation submit pull_request.create \\
    --target-json <span class="t-dim">'{"kind":"repo","owner":"acme","name":"api"}'</span> \\
    --arguments-json <span class="t-dim">'{"head":"agent-a/parser-fix"}'</span>
<span class="t-ok">op_01JQ8W3M  succeeded  pull request #482 opened</span>

<span class="t-comment"># The same agent cannot rewrite main.</span>
<span class="t-prompt">$</span> git push --force origin main
<span class="t-deny"> ! [remote rejected] main -&gt; main</span>
<span class="t-deny">   (gh-broker: no rule allows git.push.force)</span>

<span class="t-comment"># And it never held a GitHub token.</span>
<span class="t-prompt">$</span> git config --get credential.helper
<span class="t-dim">gh-broker git credential</span>`;

const operatorTranscript = `<span class="t-prompt">$</span> curl -sS --unix-socket "$OPERATOR_SOCK" \\
    -H <span class="t-dim">"Authorization: Bearer $OPERATOR_TOKEN"</span> \\
    localhost/api/operator/v1/requests?status=pending

{
  "items": [{
    "id": <span class="t-warn">"g_01JQ8W3M"</span>,
    "revision": 3,
    "requester": "agent-a",
    "operation": "git.push.force",
    "presentation": {
      "title": "Rewrite history on acme/api",
      "risk": <span class="t-deny">"high"</span>,
      "warnings": ["Removes 2 commits from main"]
    }
  }]
}

<span class="t-comment"># Approve, narrowing the window to two minutes.</span>
<span class="t-prompt">$</span> curl -sS -X POST .../g_01JQ8W3M/approve -d <span class="t-dim">'{
    "expected_revision": 3,
    "constraints": {"duration_seconds": 120}
  }'</span>
<span class="t-ok">200  state=active  uses_remaining=1</span>`;

const description =
  "BrokerKit is a Go framework for building credential brokers. Run your coding agent in YOLO " +
  "mode with the approval prompts off, because the credential it holds cannot force-push over " +
  "main, delete a repository, or reach anything you did not list.";
---

<BaseLayout title="BrokerKit" description={description} section="home">
  <div class="landing">
    <!-- ------------------------------------------------------------ hero -->
    <section class="hero">
      <div class="wrap hero__inner">
        <div>
          <h1>YOLO safely with your agents</h1>

          <p>
            BrokerKit is a Go framework for building credential brokers. Turn the approval prompts
            off and let your agent run flat out, because the credential it holds cannot force-push
            over <code>main</code>, delete a repository, or reach anything you did not list.
          </p>

          <div class="hero__actions">
            <a class="button button--primary" href="/docs/get-started/quickstart">
              Get started
              <Icon name="arrow-right" />
            </a>
            <a class="button button--secondary" href={GITHUB_REPO} rel="noopener">
              <Icon name="github" />
              View source
            </a>
          </div>
        </div>

        <div class="terminal">
          <div class="terminal__bar">agent-a@workstation</div>
          <pre class="terminal__body" set:html={agentTranscript} />
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------- with / without -->
    <section class="section section--tinted">
      <div class="wrap">
        <div class="section__intro">
          <h2>With and without a broker</h2>
          <p>
            YOLO mode means turning the approval prompts off and letting the agent work unattended.
            That is fine right up until a confused retry force-pushes over <code>main</code>, or a
            cleanup step deletes the wrong repository. The token it is holding is scoped to your
            whole account, so nothing stops either one.
          </p>
          <p>
            A broker moves the limit onto the credential itself. The agent still runs flat out, and
            the operations you never authorized fail before they reach GitHub.
          </p>
        </div>

        <AccessDiagram />
      </div>
    </section>

    <!-- ---------------------------------------------------- request path -->
    <section class="section">
      <div class="wrap">
        <div class="section__intro">
          <h2>How a request is handled</h2>
          <p>
            Every broker built on BrokerKit walks the same seven stages, whether the request is a
            Git pack, a JSON operation, or a privileged command. Only the classifier and the
            executor know anything about the provider.
          </p>
        </div>

        <ol class="flow__steps">
          {
            steps.map((step, position) => (
              <li class="flow__step">
                <span class="flow__marker">{position + 1}</span>
                <span class="flow__title">{step.title}</span>
                <p class="flow__body">{step.body}</p>
              </li>
            ))
          }
        </ol>

        <div class="decision">
          <p class="decision__label">Decision order, fixed regardless of rule order in the file</p>
          <div class="decision__chain">
            <code>deny</code>
            <span aria-hidden="true">›</span>
            <code>active grant</code>
            <span aria-hidden="true">›</span>
            <code>allow</code>
            <span aria-hidden="true">›</span>
            <code>request</code>
            <span aria-hidden="true">›</span>
            <code>no_match</code>
          </div>
          <p class="decision__note">
            Deny wins over everything, including an approved grant, and a request that matches no
            rule at all is refused.
          </p>
        </div>

        <a class="text-link" href="/docs/concepts/policy">
          Read the policy engine documentation
          <Icon name="arrow-right" />
        </a>
      </div>
    </section>

    <!-- ---------------------------------------------------------- policy -->
    <section class="section">
      <div class="wrap split">
        <div class="split__text">
          <h2>The policy file</h2>
          <p>
            A broker loads one JSON rules file at startup, and that file is the authorization source
            of truth. There is no policy UI, no inference from past behaviour, and no learning mode.
            Reading the file tells you what an agent can do, and it reviews in a pull request like
            any other code.
          </p>
          <p>
            Attrs are where the useful narrowing happens. The rule beside this text lets an agent
            push to <code>refs/heads/agent-a/**</code> and leaves <code>refs/heads/main</code>
            uncovered, so a push to the default branch matches nothing and is denied. Loading is
            strict: unknown fields, duplicate rule IDs, unsupported operations, and invalid globs
            fail the service rather than quietly widening it.
          </p>
          <a class="text-link" href="/docs/reference/policy-schema">
            Full policy schema
            <Icon name="arrow-right" />
          </a>
        </div>

        <div class="split__media">
          <div class="code-panel" data-tabs>
            <div class="code-panel__tabs" role="tablist" aria-label="Policy examples">
              <button class="code-panel__tab" role="tab" aria-selected="true" data-tab="allow">
                allow
              </button>
              <button class="code-panel__tab" role="tab" aria-selected="false" data-tab="request">
                request
              </button>
              <button class="code-panel__tab" role="tab" aria-selected="false" data-tab="deny">
                deny
              </button>
            </div>
            <div class="code-panel__pane" data-pane="allow" role="tabpanel">
              <Code code={scopeAllow} lang="json" themes={shiki} />
            </div>
            <div class="code-panel__pane" data-pane="request" role="tabpanel" hidden>
              <Code code={scopeRequest} lang="json" themes={shiki} />
            </div>
            <div class="code-panel__pane" data-pane="deny" role="tabpanel" hidden>
              <Code code={scopeDeny} lang="json" themes={shiki} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- -------------------------------------------------------- approval -->
    <section class="section section--tinted">
      <div class="wrap split split--reverse">
        <div class="split__text">
          <h2>Operator approval</h2>
          <p>
            Marking an operation <code>request</code> parks it instead of running it. The broker
            creates a durable approval record and holds the original call open, so an approved
            <code>git push</code> resumes as the same push rather than asking the agent to start
            again. A denial, an expiry, or changed upstream state returns an ordinary Git failure
            and forwards nothing.
          </p>
          <p>
            You decide through a protected inbox on a separate listener, with its own credential
            that no agent holds. Telegram is an optional view over the same durable record, so a tap
            on Approve and a call to the inbox API close the same request exactly once. Approving
            can shorten the window or reduce the use count; it can never swap the operation, the
            target, or the plan the broker will execute.
          </p>
          <a class="text-link" href="/docs/concepts/approvals">
            How approvals work
            <Icon name="arrow-right" />
          </a>
        </div>

        <div class="split__media">
          <div class="terminal">
            <div class="terminal__bar">operator@host</div>
            <pre class="terminal__body" set:html={operatorTranscript} />
          </div>
        </div>
      </div>
    </section>

    <!-- --------------------------------------------------------- brokers -->
    <section class="section">
      <div class="wrap">
        <div class="section__intro">
          <h2>Brokers included</h2>
          <p>
            Three brokers ship ready to run. Each is a separate process with its own listener,
            credential domain, state directory, release artifact, and audit stream, so one broker
            cannot reach another provider's credentials.
          </p>
        </div>

        <div class="broker-grid">
          {
            brokers.map((broker) => (
              <a class="broker-card" href={broker.href}>
                <h3>{broker.name}</h3>
                <p>{broker.blurb}</p>
                <ul class="broker-card__ops">
                  {broker.ops.map((op) => (
                    <li>{op}</li>
                  ))}
                </ul>
                <span class="broker-card__more">
                  Documentation
                  <Icon name="arrow-right" />
                </span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ------------------------------------------------------- framework -->
    <section class="section section--tinted">
      <div class="wrap">
        <div class="section__intro">
          <h2>Build a broker for anything else</h2>
          <p>
            The three shipped brokers are consumers of the framework rather than the product of it.
            To put the same policy boundary in front of an internal API key, a cloud role, or a
            database superuser, you write the parts that know about that provider and inherit the
            rest. A build fails if shared code imports a provider, so the boundary stays real.
          </p>
        </div>

        <div class="owns">
          <div>
            <h3>You write</h3>
            <ul>
              <li>A classifier that reduces a request to a client, operation, target, and attrs</li>
              <li>A registry declaring your operations, target kinds, and attrs</li>
              <li>An executor that holds the credential and performs the action</li>
              <li>Bounded approval wording: titles, risk, warnings, and facts</li>
            </ul>
          </div>
          <div>
            <h3>You inherit</h3>
            <ul>
              <li>Client and operator authentication on separate credentials</li>
              <li>Policy parsing, matching, and the fixed decision order</li>
              <li>Grant lifecycle, use budgets, reservations, and idempotency</li>
              <li>The operator inbox, SSE cursors, and the Telegram channel</li>
              <li>Agent Operations V1, its MCP bridge, and restart recovery</li>
              <li>Secret-safe audit, installers, service rendering, and doctor checks</li>
            </ul>
          </div>
        </div>

        <p style="margin-top: 2rem">
          <a class="text-link" href="/docs/build/framework">
            Read the framework overview
            <Icon name="arrow-right" />
          </a>
        </p>
      </div>
    </section>

    <!-- ------------------------------------------------------------- cta -->
    <section class="cta">
      <div class="wrap">
        <h2>Run the GitHub broker in about ten minutes</h2>
        <p>
          The quickstart brings up <code>gh-broker</code> against one repository, then shows a
          branch push going through and a force push to <code>main</code> getting refused.
        </p>
        <div class="cta__actions">
          <a class="button button--primary" href="/docs/get-started/quickstart">
            Start the quickstart
            <Icon name="arrow-right" />
          </a>
          <a class="button button--secondary" href="/docs/concepts/architecture">
            Read the architecture
          </a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Tabbed policy examples on the landing page.
  document.querySelectorAll<HTMLElement>("[data-tabs]").forEach((panel) => {
    const tabs = [...panel.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const panes = [...panel.querySelectorAll<HTMLElement>("[data-pane]")];

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((other) => other.setAttribute("aria-selected", String(other === tab)));
        panes.forEach((pane) => {
          pane.hidden = pane.dataset.pane !== tab.dataset.tab;
        });
      });
    });
  });
</script>
