---
/**
 * unYOLO shield mark. The shield follows `currentColor` so it works in both
 * site themes; the U remains teal.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 320 368"
  role="img"
  aria-label="unYOLO"
  xmlns="http://www.w3.org/2000/svg"
>
  <path
    d="M160 18 286 68v105c0 84-49 151-126 179C83 324 34 257 34 173V68L160 18Z"
    fill="currentColor"
  ></path>
  <path
    d="M94 108v96c0 47 26 73 66 73s66-26 66-73v-96"
    fill="none"
    stroke="#05b6af"
    stroke-width="42"
    stroke-linecap="round"
    stroke-linejoin="round"
  ></path>
</svg>
