---
/**
 * BrokerKit logo mark, traced from assets/logo.svg in the repository root.
 * The navy shape follows `currentColor` so the mark inherits header text
 * colour in both themes; the counter keeps the brand teal.
 */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
