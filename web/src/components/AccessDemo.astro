---
/**
 * Interactive diagram for the landing page. The agent and each GitHub resource
 * are objects on a stage; clicking an action animates a request between them.
 * With the broker off, dangerous requests land and visibly damage the target.
 * With it on, they stop at the broker.
 *
 * Styles are scoped here rather than in landing.css because this widget's
 * markup and CSS are meaningless apart from each other.
 */
const actions = [
  { id: "push", label: "git push agent-a/parser-fix", target: "branch" },
  { id: "force", label: "git push --force main", target: "main" },
  { id: "delete", label: "repo.delete acme/api", target: "repo" },
  { id: "read", label: "read acme/secrets", target: "secrets" },
];

const targets = [
  { id: "branch", name: "agent-a/parser-fix", kind: "branch" },
  { id: "main", name: "main", kind: "branch" },
  { id: "repo", name: "acme/api", kind: "repository" },
  { id: "secrets", name: "acme/secrets", kind: "private repository" },
];
---

<div class="demo" data-demo>
  <div class="demo__bar">
    <button class="demo__switch" type="button" role="switch" aria-checked="false" data-toggle>
      <span class="demo__switch-track"><span class="demo__switch-knob"></span></span>
      <span class="demo__switch-label">BrokerKit</span>
    </button>
    <p class="demo__hint" data-hint>Broker is off. Try one of the requests below.</p>
  </div>

  <div class="demo__stage">
    <div class="demo__node" data-agent>
      <span class="demo__node-kind">agent</span>
      <span class="demo__node-name">agent-a</span>
      <span class="demo__holds" data-holds>holds your GitHub token</span>
    </div>

    <div class="demo__track" data-track>
      <span class="demo__wire"></span>
      <span class="demo__gate" data-gate hidden>
        <span class="demo__gate-label">broker</span>
      </span>
      <span class="demo__packet" data-packet hidden></span>
    </div>

    <ul class="demo__targets">
      {
        targets.map((target) => (
          <li class="demo__target" data-target={target.id}>
            <span class="demo__target-name">{target.name}</span>
            <span class="demo__target-kind" data-kind>
              {target.kind}
            </span>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="demo__actions">
    {
      actions.map((action) => (
        <button class="demo__action" type="button" data-action={action.id}>
          {action.label}
        </button>
      ))
    }
    <button class="demo__reset" type="button" data-reset>Reset</button>
  </div>

  <p class="demo__status" data-status role="status">
    Requests you send appear here.
  </p>

  <noscript>
    <p class="demo__status">
      With the broker off, an agent holding your token can force-push over
      <code>main</code>, delete <code>acme/api</code>, and read
      <code>acme/secrets</code>. With the broker on, only the branch push its policy
      covers goes through.
    </p>
  </noscript>
</div>

<style>
  .demo {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .demo__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    padding: 0.9rem 1.25rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
  }

  .demo__switch {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--text-strong);
    font-family: inherit;
    font-size: 0.9375rem;
    font-weight: 620;
    cursor: pointer;
  }

  .demo__switch-track {
    display: block;
    width: 2.5rem;
    height: 1.375rem;
    padding: 2px;
    border-radius: 999px;
    background: var(--border-strong);
    transition: background var(--transition);
  }

  .demo__switch-knob {
    display: block;
    width: 1.125rem;
    height: 1.125rem;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: var(--shadow-sm);
    transition: transform var(--transition);
  }

  .demo__switch[aria-checked="true"] .demo__switch-track {
    background: var(--solid);
  }

  .demo__switch[aria-checked="true"] .demo__switch-knob {
    transform: translateX(1.125rem);
  }

  .demo__hint {
    margin: 0;
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  /* --------------------------------------------------------------- stage -- */

  .demo__stage {
    display: grid;
    grid-template-columns: minmax(8rem, 10rem) minmax(4rem, 1fr) minmax(11rem, 15rem);
    align-items: center;
    gap: 1rem;
    padding: 1.75rem 1.25rem;
  }

  .demo__node {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.85rem 0.9rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
    background: var(--bg-inset);
  }

  .demo__node-kind {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .demo__node-name {
    font-family: var(--font-mono);
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-strong);
  }

  .demo__holds {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--danger-text);
  }

  .demo[data-broker="on"] .demo__holds {
    color: var(--text-faint);
  }

  /* ---------------------------------------------------------------- wire -- */

  .demo__track {
    position: relative;
    height: 3.25rem;
  }

  .demo__wire {
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: repeating-linear-gradient(
      to right,
      var(--border-strong) 0 5px,
      transparent 5px 10px
    );
  }

  .demo__gate {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--solid);
    border-radius: var(--radius-sm);
    background: var(--solid);
    color: var(--solid-contrast);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .demo__gate[hidden] {
    display: none;
  }

  .demo__packet {
    position: absolute;
    top: 50%;
    left: 0;
    width: 0.625rem;
    height: 0.625rem;
    margin-top: -0.3125rem;
    border-radius: 50%;
    background: var(--text-muted);
  }

  .demo__packet[hidden] {
    display: none;
  }

  .demo__packet[data-verdict="blocked"] {
    background: var(--danger-text);
  }

  /* ------------------------------------------------------------- targets -- */

  .demo__targets {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .demo__target {
    display: flex;
    flex-direction: column;
    padding: 0.4rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    background: var(--bg);
    transition: border-color var(--transition), opacity var(--transition);
  }

  .demo__target-name {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-strong);
  }

  .demo__target-kind {
    font-size: 0.6875rem;
    color: var(--text-faint);
  }

  .demo__target.is-hit {
    border-color: var(--danger-border);
  }

  .demo__target.is-hit .demo__target-kind {
    color: var(--danger-text);
  }

  .demo__target.is-gone .demo__target-name {
    text-decoration: line-through;
    color: var(--text-faint);
  }

  .demo__target.is-ok {
    border-color: var(--border-strong);
  }

  .demo__target.is-refused {
    opacity: 0.55;
  }

  /* ------------------------------------------------------------- actions -- */

  .demo__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0 1.25rem 1.1rem;
  }

  .demo__action,
  .demo__reset {
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    cursor: pointer;
    transition: border-color var(--transition), background var(--transition);
  }

  .demo__action:hover:not(:disabled),
  .demo__reset:hover:not(:disabled) {
    border-color: var(--text-faint);
    background: var(--bg-inset);
  }

  .demo__action:disabled,
  .demo__reset:disabled {
    opacity: 0.5;
    cursor: default;
  }

  .demo__reset {
    margin-left: auto;
    font-family: var(--font-sans);
    color: var(--text-muted);
  }

  .demo__status {
    margin: 0;
    padding: 0.85rem 1.25rem;
    border-top: 1px solid var(--border);
    background: var(--bg-subtle);
    font-size: 0.875rem;
    line-height: 1.55;
    color: var(--text-muted);
    min-height: 3.2em;
  }

  .demo__status code {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  .demo__status[data-verdict="allowed"] {
    color: var(--text);
  }

  .demo__status[data-verdict="damage"] {
    color: var(--danger-text);
  }

  @media (max-width: 46rem) {
    .demo__stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.75rem;
    }
    .demo__track {
      height: 2.25rem;
    }
    .demo__wire {
      top: 0;
      bottom: 0;
      left: 50%;
      right: auto;
      width: 1px;
      height: auto;
      background: repeating-linear-gradient(
        to bottom,
        var(--border-strong) 0 5px,
        transparent 5px 10px
      );
    }
    .demo__reset {
      margin-left: 0;
    }
  }
</style>

<script>
  type Verdict = "allowed" | "blocked" | "damage";

  type Action = {
    target: string;
    /** Outcome when no broker sits in the path. */
    open: { verdict: Verdict; text: string; state: string };
    /** Outcome with the broker in the path. */
    brokered: { verdict: Verdict; text: string; state: string };
  };

  const ACTIONS: Record<string, Action> = {
    push: {
      target: "branch",
      open: {
        verdict: "allowed",
        state: "is-ok",
        text: "Branch updated. This is the work you actually wanted.",
      },
      brokered: {
        verdict: "allowed",
        state: "is-ok",
        text: "Allowed by policy: git.push.fast_forward on refs/heads/agent-a/**.",
      },
    },
    force: {
      target: "main",
      open: {
        verdict: "damage",
        state: "is-hit",
        text: "Nothing stopped it. Two commits are gone from main and the reflog is upstream.",
      },
      brokered: {
        verdict: "blocked",
        state: "is-refused",
        text: "Refused at the broker. No rule allows git.push.force on refs/heads/main.",
      },
    },
    delete: {
      target: "repo",
      open: {
        verdict: "damage",
        state: "is-hit is-gone",
        text: "Nothing stopped it. acme/api is deleted.",
      },
      brokered: {
        verdict: "blocked",
        state: "is-refused",
        text: "Refused at the broker. repo.delete appears in no rule, so it is denied by default.",
      },
    },
    read: {
      target: "secrets",
      open: {
        verdict: "damage",
        state: "is-hit",
        text: "Nothing stopped it. The token reaches every repo you can read, including this one.",
      },
      brokered: {
        verdict: "blocked",
        state: "is-refused",
        text: "Refused at the broker. Policy lists acme/api and nothing else.",
      },
    },
  };

  const root = document.querySelector<HTMLElement>("[data-demo]");

  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const hint = root.querySelector<HTMLElement>("[data-hint]")!;
    const holds = root.querySelector<HTMLElement>("[data-holds]")!;
    const track = root.querySelector<HTMLElement>("[data-track]")!;
    const gate = root.querySelector<HTMLElement>("[data-gate]")!;
    const packet = root.querySelector<HTMLElement>("[data-packet]")!;
    const status = root.querySelector<HTMLElement>("[data-status]")!;
    const resetButton = root.querySelector<HTMLButtonElement>("[data-reset]")!;
    const actionButtons = [...root.querySelectorAll<HTMLButtonElement>("[data-action]")];

    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let brokerOn = false;
    let busy = false;

    root.dataset.broker = "off";

    function clearTargets() {
      root!.querySelectorAll<HTMLElement>("[data-target]").forEach((el) => {
        el.classList.remove("is-hit", "is-gone", "is-ok", "is-refused");
      });
    }

    function setBroker(on: boolean) {
      brokerOn = on;
      root!.dataset.broker = on ? "on" : "off";
      toggle.setAttribute("aria-checked", String(on));
      gate.hidden = !on;
      holds.textContent = on ? "holds a broker credential" : "holds your GitHub token";
      hint.textContent = on
        ? "Broker is on. The same requests now go through policy."
        : "Broker is off. Try one of the requests below.";
      clearTargets();
      status.textContent = "Requests you send appear here.";
      delete status.dataset.verdict;
    }

    /** Distance the packet travels, in pixels, before it stops. */
    function travel(blocked: boolean): number {
      const width = track.getBoundingClientRect().width;
      if (blocked) {
        // Stop at the near edge of the broker, which is centred on the track.
        return Math.max(0, width / 2 - gate.getBoundingClientRect().width / 2 - 12);
      }
      return Math.max(0, width - packet.getBoundingClientRect().width);
    }

    async function send(id: string) {
      const action = ACTIONS[id];
      if (!action || busy) return;
      busy = true;
      actionButtons.forEach((b) => (b.disabled = true));
      resetButton.disabled = true;
      clearTargets();

      const outcome = brokerOn ? action.brokered : action.open;
      const blocked = outcome.verdict === "blocked";

      packet.hidden = false;
      packet.dataset.verdict = blocked ? "blocked" : "passed";
      packet.style.transform = "translateX(0)";

      const distance = travel(blocked);
      const flight = packet.animate(
        [{ transform: "translateX(0)" }, { transform: `translateX(${distance}px)` }],
        { duration: reduceMotion ? 1 : 620, easing: "cubic-bezier(0.4, 0, 0.2, 1)", fill: "forwards" },
      );
      await flight.finished;

      if (blocked) {
        await packet.animate(
          [
            { transform: `translateX(${distance}px)`, opacity: 1 },
            { transform: `translateX(${distance - 10}px)`, opacity: 0 },
          ],
          { duration: reduceMotion ? 1 : 260, fill: "forwards" },
        ).finished;
      } else {
        packet.hidden = true;
      }
      packet.hidden = true;

      const target = root!.querySelector<HTMLElement>(`[data-target="${action.target}"]`);
      if (target) outcome.state.split(" ").forEach((c) => target.classList.add(c));

      status.textContent = outcome.text;
      status.dataset.verdict = outcome.verdict;

      busy = false;
      actionButtons.forEach((b) => (b.disabled = false));
      resetButton.disabled = false;
    }

    toggle.addEventListener("click", () => {
      if (busy) return;
      setBroker(!brokerOn);
    });

    actionButtons.forEach((button) => {
      button.addEventListener("click", () => void send(button.dataset.action!));
    });

    resetButton.addEventListener("click", () => {
      if (busy) return;
      clearTargets();
      status.textContent = "Requests you send appear here.";
      delete status.dataset.verdict;
    });
  }
</script>
