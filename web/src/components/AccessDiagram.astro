---
import {
  isoDefs,
  isoStopCss,
  isoPaintCss,
  personIcon,
  agentIcon,
  brokerIcon,
  cubeIcon,
  policyIcon,
} from "../lib/iso";

/**
 * Two stacked scenarios on the landing page. The top one hands your credential
 * straight to the agent, so every wire out of it is live. The bottom one gives
 * the credential to the broker instead, so only the wire policy allows carries
 * current.
 *
 * Everything here is inline SVG plus CSS, so the diagram works with scripting
 * disabled.
 */

// The right-hand column models the real hierarchy. Two branches sit inside
// acme/api, which is itself a target because the repository can be deleted.
// acme/secrets is a separate repository.
const P = "dg";

const REPO_BOX = { x: 596, y: 16, w: 296, h: 146 };

const targets = [
  // `safe` is the work you actually wanted; it behaves the same in both rows.
  { id: "branch", y: 90, endX: REPO_BOX.x, name: "agent-a/parser-fix", note: "branch", indent: true, safe: true },
  { id: "main", y: 136, endX: REPO_BOX.x, name: "main", note: "default branch", indent: true },
  { id: "repo", y: 44, endX: REPO_BOX.x, name: "acme/api", note: "repository" },
  { id: "secrets", y: 208, endX: 608, name: "acme/secrets", note: "private repo" },
];

/** Wire from a hub on the left to a target on the right. */
const wire = (fromX: number, y: number, endX: number) =>
  `M ${fromX} 130 C ${fromX + 110} 130, ${fromX + 150} ${y}, ${endX} ${y}`;

/**
 * Point on that cubic bezier at t, so a cut marker lands exactly on its wire
 * instead of being eyeballed. t = 0.6 is far enough along that the four wires
 * have fanned apart.
 */
function pointOnWire(fromX: number, y: number, endX: number, t = 0.6) {
  const p0 = { x: fromX, y: 130 };
  const p1 = { x: fromX + 110, y: 130 };
  const p2 = { x: fromX + 150, y };
  const p3 = { x: endX, y };
  const u = 1 - t;
  const a = u * u * u;
  const b = 3 * u * u * t;
  const c = 3 * u * t * t;
  const d = t * t * t;
  return {
    x: a * p0.x + b * p1.x + c * p2.x + d * p3.x,
    y: a * p0.y + b * p1.y + c * p2.y + d * p3.y,
  };
}
---

<div class="diagram">
  <svg class="diagram__defs" aria-hidden="true" focusable="false">
    <defs set:html={isoDefs(P)} />
  </svg>
  <!-- ------------------------------------------------------- loose agent -- -->
  <figure class="scenario scenario--risk">
    <figcaption class="scenario__caption">
      <span class="scenario__tag">Without a broker</span>
      <p class="scenario__line">
        You hand the token to the agent. It does the work you wanted, and the same token reaches
        everything else in your account.
      </p>
    </figcaption>

    <svg class="scenario__svg" viewBox="0 0 900 268" role="img" aria-labelledby="loose-title">
      <title id="loose-title">
        You give your GitHub token to the agent. It pushes the branch you wanted, and the same
        token also reaches the default branch, the acme/api repository itself, and a separate
        private repository.
      </title>

      {/* The work you wanted stays green in both rows; the rest is loose reach. */}
      {
        targets.map((t) => (
          <>
            <path class="wire wire--base" d={wire(330, t.y, t.endX)} />
            <path
              class={`wire ${t.safe ? "wire--live" : "wire--danger"}`}
              d={wire(330, t.y, t.endX)}
            />
            <circle
              class={`spark ${t.safe ? "spark--live" : "spark--danger"}`}
              r="3.5"
              style={`offset-path: path('${wire(330, t.y, t.endX)}')`}
            />
          </>
        ))
      }

      {/* you -> agent, carrying the token */}
      <path class="wire wire--base" d="M 132 130 L 270 130" />
      <path class="wire wire--danger" d="M 132 130 L 270 130" />
      <circle class="spark spark--danger" r="3.5" style="offset-path: path('M 132 130 L 270 130')" />
      <g class="token" transform="translate(201 130)">
        <rect x="-27" y="-11" width="54" height="22" rx="11" />
        <text x="0" y="4">token</text>
      </g>

      <g transform="translate(90 130)" set:html={personIcon(P)} />
      <g transform="translate(300 130)" set:html={agentIcon(P, "alarm")} />
      <text class="node-label" x="90" y="196" text-anchor="middle">YOU</text>
      <text class="node-label" x="300" y="196" text-anchor="middle">AGENT</text>

      {/* acme/api frame: the two branches live inside the repository */}
      <rect
        class="repo-frame"
        x={REPO_BOX.x}
        y={REPO_BOX.y}
        width={REPO_BOX.w}
        height={REPO_BOX.h}
        rx="10"
      />
      <line class="repo-rule" x1={REPO_BOX.x + 14} y1="66" x2={REPO_BOX.x + REPO_BOX.w - 14} y2="66" />

      {
        targets.map((t) => (
          <>
            <g transform={`translate(${t.indent ? 646 : 622} ${t.y})`} set:html={cubeIcon(P)} />
            <text class="res-name" x={t.indent ? 676 : 652} y={t.y - 1}>
              {t.name}
            </text>
            <text class="res-note" x={t.indent ? 676 : 652} y={t.y + 13}>
              {t.note}
            </text>
          </>
        ))
      }
    </svg>
  </figure>

  <!-- ------------------------------------------------------ brokered path -- -->
  <figure class="scenario scenario--safe">
    <figcaption class="scenario__caption">
      <span class="scenario__tag">With unYOLO</span>
      <p class="scenario__line">
        The broker holds the token. The agent asks for the same work, and the calls you never
        authorized are refused.
      </p>
    </figcaption>

    <svg class="scenario__svg" viewBox="0 0 900 268" role="img" aria-labelledby="brokered-title">
      <title id="brokered-title">
        You give your GitHub token to the broker. The agent sends requests to the broker, which
        checks them against your scope.json, allows the same branch push and returns its result,
        and refuses the other three.
      </title>

      {
        targets.map((t) => (
          <>
            <path class="wire wire--base" d={wire(400, t.y, t.endX)} />
            {t.safe ? (
              <>
                <path class="wire wire--live" d={wire(400, t.y, t.endX)} />
                <circle
                  class="spark spark--live"
                  r="3.5"
                  style={`offset-path: path('${wire(400, t.y, t.endX)}')`}
                />
              </>
            ) : (
              <g
                class="cut"
                transform={`translate(${pointOnWire(400, t.y, t.endX).x.toFixed(1)} ${pointOnWire(400, t.y, t.endX).y.toFixed(1)})`}
              >
                <line x1="-7" y1="-7" x2="7" y2="7" />
                <line x1="7" y1="-7" x2="-7" y2="7" />
              </g>
            )}
          </>
        ))
      }

      {/* you -> broker, carrying the token */}
      <path class="wire wire--base" d="M 128 78 C 210 88, 250 100, 322 118" />
      <path class="wire wire--live" d="M 128 78 C 210 88, 250 100, 322 118" />
      <g class="token" transform="translate(216 96)">
        <rect x="-27" y="-11" width="54" height="22" rx="11" />
        <text x="0" y="4">token</text>
      </g>

      {/* agent -> broker, carrying only a request */}
      <path class="wire wire--base" d="M 128 190 C 210 180, 250 166, 322 144" />
      <path class="wire wire--request" d="M 128 190 C 210 180, 250 166, 322 144" />
      <g class="token token--muted" transform="translate(214 166)">
        <rect x="-33" y="-11" width="66" height="22" rx="11" />
        <text x="0" y="4">request</text>
      </g>

      {/* broker -> agent, returning the result of the allowed call */}
      <path class="wire wire--base" d="M 326 158 C 254 190, 214 206, 130 212" />
      <path class="wire wire--live" d="M 326 158 C 254 190, 214 206, 130 212" />
      <circle
        class="spark spark--live"
        r="3.2"
        style="offset-path: path('M 326 158 C 254 190, 214 206, 130 212')"
      />
      <g class="token token--muted" transform="translate(224 202)">
        <rect x="-27" y="-11" width="54" height="22" rx="11" />
        <text x="0" y="4">result</text>
      </g>

      {/* the policy the broker checks against */}
      <path class="wire wire--base" d="M 370 66 L 370 90" />
      <g transform="translate(370 44)" set:html={policyIcon(P)} />
      <text class="res-note" x="370" y="70" text-anchor="middle">scope.json</text>

      <g transform="translate(88 74)" set:html={personIcon(P)} />
      <g transform="translate(88 190)" set:html={agentIcon(P, "happy")} />
      <g transform="translate(370 130)" set:html={brokerIcon(P)} />
      <text class="node-label" x="88" y="130" text-anchor="middle">YOU</text>
      <text class="node-label" x="88" y="250" text-anchor="middle">AGENT</text>
      <text class="node-label" x="370" y="200" text-anchor="middle">BROKER</text>

      {/* acme/api frame: the two branches live inside the repository */}
      <rect
        class="repo-frame"
        x={REPO_BOX.x}
        y={REPO_BOX.y}
        width={REPO_BOX.w}
        height={REPO_BOX.h}
        rx="10"
      />
      <line class="repo-rule" x1={REPO_BOX.x + 14} y1="66" x2={REPO_BOX.x + REPO_BOX.w - 14} y2="66" />

      {
        targets.map((t) => (
          <>
            <g transform={`translate(${t.indent ? 646 : 622} ${t.y})`} set:html={cubeIcon(P)} class:list={[!t.safe && "is-dim"]} />
            <text class:list={["res-name", !t.safe && "is-dim"]} x={t.indent ? 676 : 652} y={t.y - 1}>
              {t.name}
            </text>
            <text class="res-note" x={t.indent ? 676 : 652} y={t.y + 13}>
              {t.note}
            </text>
          </>
        ))
      }
    </svg>
  </figure>
</div>

<style set:html={isoStopCss}></style>
<style set:html={isoPaintCss}></style>

<style>
  .diagram {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .scenario {
    margin: 0;
    padding: 1.25rem 1.4rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
  }

  .scenario--risk {
    border-color: var(--danger-border);
  }

  .scenario__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 0.9rem;
    margin-bottom: 0.35rem;
  }

  .scenario__tag {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .scenario--risk .scenario__tag {
    color: var(--danger-text);
  }

  .scenario__line {
    margin: 0;
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .scenario__svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  /* ------------------------------------------------------------- shapes -- */

  .diagram__defs {
    position: absolute;
    width: 0;
    height: 0;
  }


  .scenario__svg :global(.is-dim) {
    opacity: 0.4;
  }

  .node-label {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    fill: var(--text-faint);
  }

  .repo-frame {
    fill: none;
    stroke: var(--border);
    stroke-width: 1.5;
    rx: 10;
  }

  .repo-rule {
    stroke: var(--border);
    stroke-width: 1;
  }

  .res-name {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--text-strong);
  }

  .res-note {
    font-family: var(--font-sans);
    font-size: 10.5px;
    fill: var(--text-faint);
  }

  .res-name.is-dim {
    fill: var(--text-faint);
  }

  /* -------------------------------------------------------------- wires -- */

  .wire {
    fill: none;
    stroke-linecap: round;
  }

  .wire--base {
    stroke: var(--border-strong);
    stroke-width: 1.5;
  }

  /* Marching dashes read as current moving along the wire. */
  .wire--danger,
  .wire--live,
  .wire--request {
    stroke-width: 2;
    stroke-dasharray: 5 9;
    animation: current 0.85s linear infinite;
  }

  .wire--danger {
    stroke: var(--wire-danger);
    animation-duration: 0.55s;
  }

  .wire--live {
    stroke: var(--wire-live);
  }

  .wire--request {
    stroke: var(--text-faint);
    animation-duration: 1.3s;
  }

  @keyframes current {
    to {
      stroke-dashoffset: -14;
    }
  }

  /* A brighter pulse riding the same path. */
  .spark {
    offset-rotate: 0deg;
    animation: travel 2.1s linear infinite;
  }

  .spark--danger {
    fill: var(--wire-danger);
    animation-duration: 1.5s;
  }

  .spark--live {
    fill: var(--wire-live);
  }

  @keyframes travel {
    from {
      offset-distance: 0%;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    to {
      offset-distance: 100%;
      opacity: 0;
    }
  }

  .cut line {
    stroke: var(--danger-text);
    stroke-width: 2.25;
    stroke-linecap: round;
  }

  .token rect {
    fill: var(--bg);
    stroke: var(--border-strong);
    stroke-width: 1;
  }

  .token text {
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-anchor: middle;
    fill: var(--text-muted);
  }

  .scenario--risk .token rect {
    stroke: var(--danger-border);
  }

  .scenario--risk .token text {
    fill: var(--danger-text);
  }

  .token--muted rect {
    stroke: var(--border);
  }

  /* --------------------------------------------------------------- misc -- */

  @media (max-width: 46rem) {
    .scenario {
      padding: 1rem 0.9rem 0.75rem;
    }
    .scenario__svg {
      min-width: 520px;
    }
    .scenario > svg {
      display: block;
    }
    .scenario {
      overflow-x: auto;
    }
  }
</style>
