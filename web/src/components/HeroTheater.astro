---
/**
 * The hero's right pane, staged as a play with a scrubbable timeline.
 *
 * Act 1  the two characters walk on and talk
 * Act 2  the agent takes its desk, works, and its first merge is refused
 * Act 3  it asks instead; the phone comes out and the operator approves
 * Act 4  the operation resumes and the merge lands
 *
 * The scene is a list of cues on a clock rather than a sequential script, so
 * any point is reachable: seeking replays every cue up to that time with
 * transitions suppressed, then playback resumes from there. Every cue sets
 * state outright, which is what makes replaying a prefix idempotent.
 *
 * The agent has two kinds of bubble. Speech is what it says to you; thought is
 * what it is working through on its own, and reads differently.
 */
import { isoDefs, isoStopCss, isoPaintCss, personIcon, agentIcon } from "../lib/iso";

const P = "th";

const lines = [
  { text: "$ gh-broker operation submit pull_request.create" },
  { text: "op_9c2f  succeeded  pull request #482 opened", tone: "ok" },
  { text: "$ gh-broker operation submit pull_request.merge" },
  { text: "op_1d55  pending    policy requires operator approval", tone: "warn" },
  { text: "op_1d55  approved   by operator, single use", tone: "ok" },
  { text: "op_1d55  succeeded  pull request #482 merged", tone: "ok" },
];
---

<div class="theater">
  <div class="stagewrap">
    <div class="stage" data-stage data-act="0" data-focus="none" data-face="idle">
      <svg class="stage__defs" aria-hidden="true" focusable="false">
        <defs set:html={isoDefs(P)} />
      </svg>

      <div class="actor actor--human">
        <svg class="actor__art" viewBox="-34 -50 68 92" set:html={personIcon(P)} />
        <span class="actor__name">YOU</span>
      </div>

      <div class="actor actor--agent">
        <svg class="actor__art" viewBox="-38 -52 76 96" set:html={agentIcon(P, "switchable")} />
        <span class="actor__name">AGENT</span>
        <span class="dots" data-dots aria-hidden="true"><i></i><i></i><i></i></span>
      </div>

      <p class="say say--human" data-say-human></p>
      <p class="say say--agent" data-say-agent></p>
      <p class="say say--think" data-thought></p>

      <div class="term" data-term>
        <div class="term__bar">agent-a@workstation</div>
        <pre class="term__body"><code>{
          lines.map((l, i) => (
            <span class="ln" data-ln={i} data-tone={l.tone ?? "plain"}>{l.text}</span>
          ))
        }</code></pre>
      </div>

      <div class="phone" data-phone>
        <div class="tgbar">
          <span class="tgbar__back">‹</span>
          <span class="tgbar__ava">u</span>
          <span class="tgbar__who"><b>unYOLO</b><i>bot</i></span>
        </div>
        <div class="tgchat">
          <div class="tgmsg" data-tg>
            <p class="tgmsg__from">unYOLO</p>
            <p class="tgmsg__title">Approval required</p>
            <p class="tgmsg__body">
              <b>agent-a</b> wants to merge <b>#482</b> in <b>acme/api</b>.
            </p>
            <p class="tgmsg__warn">Merging is not in this agent's policy.</p>
            <span class="tgmsg__time">09:41</span>
            <div class="tgkb" data-actions>
              <button class="tgkb__btn" type="button" data-approve>
                Approve · 1 use
                <span class="ripple" data-ripple></span>
              </button>
              <button class="tgkb__btn" type="button" disabled>Deny</button>
            </div>
            <div class="tgkb tgkb--done" data-tgok hidden>
              <span class="tgkb__done">✓ Approved by you</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="ctl">
    <button class="ctl__btn" type="button" data-toggle aria-label="Pause">
      <svg class="ctl__pause" viewBox="0 0 12 12" aria-hidden="true"
        ><rect x="2" y="1.5" width="3" height="9" rx="1"></rect><rect x="7" y="1.5" width="3" height="9" rx="1"
        ></rect></svg
      >
      <svg class="ctl__play" viewBox="0 0 12 12" aria-hidden="true"
        ><path d="M3 1.5 L10.5 6 L3 10.5 Z"></path></svg
      >
    </button>
    <input
      class="ctl__seek"
      type="range"
      min="0"
      max="1000"
      value="0"
      step="1"
      data-seek
      aria-label="Scrub the scene"
    />
    <button class="ctl__rate" type="button" data-rate>1x</button>
  </div>
</div>

<style set:html={isoStopCss}></style>
<style set:html={isoPaintCss}></style>

<style>
  .theater {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .stagewrap {
    height: 520px;
    overflow: hidden;
  }

  .stage {
    position: relative;
    width: 520px;
    height: 520px;
    transform-origin: top left;
  }

  /* Applied while seeking, so a jump lands instantly instead of sliding. */
  .stage.is-seeking,
  .stage.is-seeking * {
    transition: none !important;
  }

  .stage__defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* -------------------------------------------------------------- actors -- */

  .actor {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    width: 120px;
    margin: -70px 0 0 -60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    transform: translate(var(--x, 0), var(--y, 0)) scale(calc(var(--s, 1) * var(--f, 1)));
    opacity: var(--o, 0);
    transition:
      transform calc(760ms / var(--rate, 1)) cubic-bezier(0.5, 0, 0.2, 1),
      opacity calc(460ms / var(--rate, 1)) ease;
  }

  .actor__art {
    width: 100px;
    height: auto;
    overflow: visible;
  }

  .actor__name {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .stage[data-act="0"] .actor--human {
    --x: -230px;
    --y: 60px;
    --o: 0;
  }
  .stage[data-act="0"] .actor--agent {
    --x: 230px;
    --y: 60px;
    --o: 0;
  }

  .stage[data-act="1"] .actor--human,
  .stage[data-act="1"] .actor--agent {
    --o: 1;
    --y: 60px;
  }
  .stage[data-act="1"] .actor--human {
    --x: -110px;
  }
  .stage[data-act="1"] .actor--agent {
    --x: 110px;
  }

  .stage[data-act="2"] .actor--agent,
  .stage[data-act="3"] .actor--agent,
  .stage[data-act="4"] .actor--agent {
    --o: 1;
    --x: -196px;
    --y: -186px;
    --s: 0.6;
  }
  .stage[data-act="2"] .actor--human,
  .stage[data-act="4"] .actor--human {
    --o: 1;
    --x: -196px;
    --y: 150px;
    --s: 0.6;
  }
  .stage[data-act="3"] .actor--human {
    --o: 1;
    --x: -198px;
    --y: 144px;
    --s: 0.6;
  }

  /*
   * Whoever holds the floor grows a little and shrinks back when the turn
   * passes. The bump is smaller in act 1 because both actors are already at
   * full size there.
   */
  .stage[data-focus="human"] .actor--human,
  .stage[data-focus="agent"] .actor--agent {
    --f: 1.23;
  }
  .stage[data-act="1"][data-focus="human"] .actor--human,
  .stage[data-act="1"][data-focus="agent"] .actor--agent {
    --f: 1.08;
  }

  /* ----------------------------------------------------------------- face -- */

  .actor__art :global(.face) {
    display: none;
  }
  .stage[data-face="idle"] .actor__art :global(.face--idle),
  .stage[data-face="happy"] .actor__art :global(.face--happy),
  .stage[data-face="think"] .actor__art :global(.face--think),
  .stage[data-face="wink"] .actor__art :global(.face--wink),
  .stage[data-face="stuck"] .actor__art :global(.face--stuck) {
    display: block;
  }

  /* ---------------------------------------------------------------- dots -- */

  .dots {
    position: absolute;
    top: -2px;
    right: 4px;
    display: flex;
    gap: 3px;
    padding: 4px 6px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    opacity: 0;
    transform: scale(0.7);
    transition: opacity calc(220ms / var(--rate, 1)) ease, transform calc(260ms / var(--rate, 1)) cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .dots.is-on {
    opacity: 1;
    transform: none;
  }

  .dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-faint);
    animation: bob calc(1.15s / var(--rate, 1)) ease-in-out infinite;
  }
  .dots i:nth-child(2) {
    animation-delay: calc(0.16s / var(--rate, 1));
  }
  .dots i:nth-child(3) {
    animation-delay: calc(0.32s / var(--rate, 1));
  }

  @keyframes bob {
    0%,
    70%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    35% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  /* ------------------------------------------------------ speech, thought -- */

  /*
   * Every bubble carries a tail aimed at whoever produced it, so the eye can
   * tell speaker from bubble without reading either. Because the actors move
   * between acts, the tail moves with them. It sits on the bubble edge facing
   * the speaker, at the offset (--tx along the bottom, --ty down the left)
   * that lines it up with their head, and the pop-in grows from that point so
   * the bubble looks like it came out of the actor.
   *
   * The offsets are tuned against measured positions, so changing an actor's
   * --x/--y, or the text in a bubble, means re-checking the tail it feeds.
   */
  .say {
    --bubble-bg: var(--bg-inset);
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 50%;
    width: max-content;
    max-width: 194px;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--bubble-bg);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text);
    box-shadow: var(--shadow-sm);
    opacity: 0;
    transform: translate(var(--sx), var(--sy)) translateY(10px) scale(0.94);
    transition: opacity calc(240ms / var(--rate, 1)) ease, transform calc(400ms / var(--rate, 1)) cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }

  .say.is-in {
    opacity: 1;
    transform: translate(var(--sx), var(--sy));
  }

  /*
   * The tail is two stacked border triangles: ::before in the border colour,
   * ::after a pixel smaller in the fill, which leaves a rim matching the
   * bubble's own outline.
   */
  .say--human::before,
  .say--human::after,
  .say--agent::before,
  .say--agent::after {
    content: "";
    position: absolute;
    width: 0;
    height: 0;
    border: 9px solid transparent;
  }

  .say--human::before,
  .say--human::after,
  .stage[data-act="1"] .say--agent::before,
  .stage[data-act="1"] .say--agent::after {
    left: var(--tx);
    border-bottom-width: 0;
  }
  .say--human::before,
  .stage[data-act="1"] .say--agent::before {
    top: 100%;
    margin-left: -9px;
    border-top-color: var(--border);
  }
  .say--human::after,
  .stage[data-act="1"] .say--agent::after {
    top: calc(100% - 1.5px);
    margin-left: -8px;
    border-width: 8px;
    border-bottom-width: 0;
    border-top-color: var(--bubble-bg);
  }

  .stage[data-act="2"] .say--agent::before,
  .stage[data-act="2"] .say--agent::after,
  .stage[data-act="3"] .say--agent::before,
  .stage[data-act="3"] .say--agent::after,
  .stage[data-act="4"] .say--agent::before,
  .stage[data-act="4"] .say--agent::after {
    top: var(--ty);
    left: auto;
    border-left-width: 0;
    border-bottom-width: 9px;
  }
  .stage[data-act="2"] .say--agent::before,
  .stage[data-act="3"] .say--agent::before,
  .stage[data-act="4"] .say--agent::before {
    right: 100%;
    margin-top: -9px;
    margin-left: 0;
    border-right-color: var(--border);
    border-top-color: transparent;
  }
  .stage[data-act="2"] .say--agent::after,
  .stage[data-act="3"] .say--agent::after,
  .stage[data-act="4"] .say--agent::after {
    top: var(--ty);
    right: calc(100% - 1.5px);
    margin-top: -8px;
    margin-left: 0;
    border-width: 8px;
    border-left-width: 0;
    border-right-color: var(--bubble-bg);
    border-top-color: transparent;
  }

  /* Act 1: the two stand centre stage and speak up into their bubbles. */
  .say--human {
    --sx: -246px;
    --sy: -72px;
    --tx: 136px;
    transform-origin: var(--tx) 100%;
  }

  .say--agent {
    --bubble-bg: var(--bg-subtle);
    --sx: 46px;
    --sy: -72px;
    --tx: 64px;
    transform-origin: var(--tx) 100%;
  }

  /* From act 2 on, the agent sits at the desk to the left of its bubbles. */
  .stage[data-act="2"] .say--agent,
  .stage[data-act="3"] .say--agent,
  .stage[data-act="4"] .say--agent {
    --sx: -116px;
    --sy: -232px;
    --ty: 62%;
    transform-origin: 0 var(--ty);
  }

  /* Narrower here so it does not run under the phone standing beside it. */
  .stage[data-act="3"] .say--human {
    --sx: -252px;
    --sy: 8px;
    --tx: 54px;
    max-width: 132px;
  }

  /* A thought reads as internal: dashed, italic, quieter, with a cloud tail. */
  .say--think {
    --sx: -116px;
    --sy: -232px;
    max-width: 200px;
    border-style: dashed;
    border-radius: 15px;
    background: var(--bg);
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--text-muted);
    box-shadow: none;
    transform-origin: 0 58%;
  }

  /* The cloud trails left toward the agent's antenna, not down into the desk. */
  .say--think::before,
  .say--think::after {
    content: "";
    position: absolute;
    border: 1px dashed var(--border);
    border-radius: 50%;
    background: var(--bg);
  }

  .say--think::before {
    left: -15px;
    top: 52%;
    width: 9px;
    height: 9px;
  }

  .say--think::after {
    left: -33px;
    top: 33%;
    width: 6px;
    height: 6px;
  }

  /* ------------------------------------------------------------ terminal -- */

  .term {
    position: absolute;
    z-index: 1;
    left: 112px;
    top: 92px;
    right: 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transform-origin: 0 0;
    transition: opacity calc(340ms / var(--rate, 1)) ease, transform calc(520ms / var(--rate, 1)) cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .term.is-in {
    opacity: 1;
    transform: none;
  }

  .term__bar {
    padding: 0.35rem 0.7rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-faint);
  }

  .term__body {
    margin: 0;
    padding: 0.6rem 0.75rem;
    min-height: 11.1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.85;
    color: var(--text);
  }

  .ln {
    display: block;
    white-space: pre;
    opacity: 0;
    transform: translateY(6px);
  }

  /* Blank line before each new prompt, reserved up front so nothing shifts. */
  .ln[data-tone="plain"]:not(:first-child) {
    margin-top: 0.85em;
  }

  .ln.is-in {
    opacity: 1;
    transform: none;
    transition: opacity calc(240ms / var(--rate, 1)) ease, transform calc(300ms / var(--rate, 1)) cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ln[data-tone="ok"] {
    color: #2f7a4d;
  }
  .ln[data-tone="warn"] {
    color: #97690e;
  }
  .ln[data-tone="bad"] {
    color: #b4383f;
  }

  html[data-theme="dark"] .ln[data-tone="ok"] {
    color: #7fc79b;
  }
  html[data-theme="dark"] .ln[data-tone="warn"] {
    color: #d4b071;
  }
  html[data-theme="dark"] .ln[data-tone="bad"] {
    color: #ef9296;
  }

  .ln[data-caret="true"]::after {
    content: "▋";
    margin-left: 0.15rem;
    animation: blink calc(1.05s / var(--rate, 1)) steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* --------------------------------------------------------------- phone -- */
  /* Telegram's own palette, so the approval reads as the app it arrives in. */

  :global([data-theme="dark"]) .phone {
    --tg-bezel: #444b54;
  }

  .phone {
    --tg-header: #527da3;
    --tg-chat: #dfe6ec;
    --tg-bubble: #ffffff;
    --tg-text: #16191c;
    --tg-blue: #2f81d6;
    --tg-muted: #7d8e9c;
    --tg-rule: #e3e9ee;
    --tg-bezel: #1b2025;

    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    width: 224px;
    margin: -118px 0 0 -109px;
    border: 6px solid var(--tg-bezel);
    border-radius: 20px;
    background: var(--tg-chat);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    opacity: 0;
    transform: translate(-2px, 290px) scale(0.9) rotate(5deg);
    transition: opacity calc(320ms / var(--rate, 1)) ease, transform calc(640ms / var(--rate, 1)) cubic-bezier(0.34, 1.4, 0.5, 1);
    pointer-events: none;
  }

  .phone.is-in {
    opacity: 1;
    transform: translate(-2px, 108px) scale(1) rotate(0deg);
    pointer-events: auto;
  }

  .tgbar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.55rem;
    background: var(--tg-header);
    color: #fff;
  }

  .tgbar__back {
    font-size: 1rem;
    line-height: 1;
    opacity: 0.9;
  }

  .tgbar__ava {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #74a9d4;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .tgbar__who {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .tgbar__who b {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .tgbar__who i {
    font-size: 0.625rem;
    font-style: normal;
    opacity: 0.78;
  }

  .tgchat {
    padding: 0.55rem 0.5rem 0.65rem;
    min-height: 170px;
  }

  .tgmsg {
    position: relative;
    max-width: 97%;
    padding: 0.4rem 0.5rem 0.3rem;
    border-radius: 10px 10px 10px 3px;
    background: var(--tg-bubble);
    box-shadow: 0 1px 1px rgb(16 35 47 / 0.16);
    color: var(--tg-text);
    opacity: 0;
    transform: translateY(10px) scale(0.95);
    transform-origin: 0 100%;
  }

  .tgmsg.is-in {
    opacity: 1;
    transform: none;
    transition: opacity calc(240ms / var(--rate, 1)) ease, transform calc(400ms / var(--rate, 1)) cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tgmsg__from {
    margin: 0 0 0.1rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--tg-blue);
  }

  .tgmsg__title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tgmsg__body {
    margin: 0.15rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .tgmsg__warn {
    margin: 0.2rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: #b4383f;
  }

  .tgmsg__time {
    display: block;
    margin-top: 0.1rem;
    text-align: right;
    font-size: 0.5625rem;
    color: var(--tg-muted);
  }

  /* Telegram inline keyboard: attached under the bubble, blue labels. */
  .tgkb {
    display: flex;
    margin: 0.3rem -0.5rem -0.3rem;
    border-top: 1px solid var(--tg-rule);
  }

  .tgkb__btn {
    position: relative;
    flex: 1;
    padding: 0.4rem 0.3rem;
    border: 0;
    background: transparent;
    color: var(--tg-blue);
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
  }

  .tgkb__btn + .tgkb__btn {
    border-left: 1px solid var(--tg-rule);
  }

  .tgkb__btn:hover:not(:disabled) {
    background: #f1f6fa;
  }

  .tgkb__btn[disabled] {
    color: var(--tg-muted);
    cursor: default;
  }

  .tgkb[hidden] {
    display: none;
  }

  .tgkb--done {
    justify-content: center;
  }

  .tgkb__done {
    padding: 0.4rem 0.3rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #2f7a4d;
    animation: rise calc(320ms / var(--rate, 1)) cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
  }

  .ripple {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--tg-blue);
    opacity: 0;
    pointer-events: none;
  }

  .ripple.is-tap {
    animation: tap calc(520ms / var(--rate, 1)) ease-out;
  }

  @keyframes tap {
    from {
      opacity: 0.4;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(18);
    }
  }

  /* ----------------------------------------------------------- transport -- */

  .ctl {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ctl__btn {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text-muted);
    cursor: pointer;
    flex-shrink: 0;
  }

  .ctl__btn:hover {
    color: var(--text-strong);
  }

  .ctl__btn svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .ctl__play {
    display: none;
  }

  .theater[data-paused="true"] .ctl__pause {
    display: none;
  }
  .theater[data-paused="true"] .ctl__play {
    display: block;
  }

  .ctl__seek {
    flex: 1;
    height: 4px;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    background: var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  .ctl__seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: var(--solid);
  }

  .ctl__rate {
    flex-shrink: 0;
    min-width: 2.6rem;
    padding: 0.15rem 0.35rem;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    background: var(--bg);
    font: inherit;
    font-size: 0.6875rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
    cursor: pointer;
  }

  .ctl__rate:hover {
    color: var(--text-strong);
  }

  .ctl__seek::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: var(--solid);
  }

  @media (max-width: 40rem) {
    .stagewrap {
      height: 405px;
    }
    .stage {
      transform: scale(0.78);
    }
  }
</style>

<script>
  import { createScene } from "../lib/scene";

  const theater = document.querySelector<HTMLElement>(".theater");
  const stage = theater?.querySelector<HTMLElement>("[data-stage]");

  if (theater && stage) {
    const sayHuman = stage.querySelector<HTMLElement>("[data-say-human]")!;
    const sayAgent = stage.querySelector<HTMLElement>("[data-say-agent]")!;
    const thought = stage.querySelector<HTMLElement>("[data-thought]")!;
    const dots = stage.querySelector<HTMLElement>("[data-dots]")!;
    const term = stage.querySelector<HTMLElement>("[data-term]")!;
    const lns = [...stage.querySelectorAll<HTMLElement>("[data-ln]")];
    const phone = stage.querySelector<HTMLElement>("[data-phone]")!;
    const tg = stage.querySelector<HTMLElement>("[data-tg]")!;
    const actions = stage.querySelector<HTMLElement>("[data-actions]")!;
    const tgok = stage.querySelector<HTMLElement>("[data-tgok]")!;
    const approve = stage.querySelector<HTMLButtonElement>("[data-approve]")!;
    const ripple = stage.querySelector<HTMLElement>("[data-ripple]")!;
    const toggle = theater.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const seek = theater.querySelector<HTMLInputElement>("[data-seek]")!;
    const rate = theater.querySelector<HTMLButtonElement>("[data-rate]")!;

    const act = (n: string) => (stage.dataset.act = n);
    /** Who has the floor. The one with it grows; the other shrinks back. */
    const focus = (who: "human" | "agent" | "none") => (stage.dataset.focus = who);
    /** The agent's expression, which tracks what it is currently up against. */
    const face = (f: "idle" | "happy" | "think" | "wink" | "stuck") =>
      (stage.dataset.face = f);
    const show = (el: HTMLElement, text: string) => {
      el.textContent = text;
      el.classList.add("is-in");
    };
    const hide = (el: HTMLElement) => el.classList.remove("is-in");
    const line = (i: number) => lns[i]!.classList.add("is-in");

    const CUES: { t: number; fn: () => void }[] = [
      { t: 250, fn: () => act("1") },
      {
        t: 1400,
        fn: () => {
          focus("human");
          show(sayHuman, "Ship the parser fix and merge it.");
        },
      },
      { t: 3800, fn: () => hide(sayHuman) },
      {
        t: 4200,
        fn: () => {
          focus("agent");
          face("happy");
          show(sayAgent, "On it. Let me open a PR first.");
        },
      },
      { t: 6300, fn: () => hide(sayAgent) },
      {
        t: 6700,
        fn: () => {
          act("2");
          focus("agent");
          face("think");
        },
      },
      {
        t: 7400,
        fn: () => {
          dots.classList.add("is-on");
          term.classList.add("is-in");
        },
      },
      { t: 7800, fn: () => show(thought, "Opening the pull request…") },
      { t: 8300, fn: () => line(0) },
      {
        t: 9100,
        fn: () => {
          line(1);
          face("happy");
        },
      },
      { t: 9800, fn: () => hide(thought) },
      {
        t: 10000,
        fn: () => {
          face("think");
          show(thought, "Now merging it.");
        },
      },
      { t: 10400, fn: () => line(2) },
      {
        t: 11200,
        fn: () => {
          line(3);
          face("stuck");
        },
      },
      { t: 11600, fn: () => hide(thought) },
      { t: 11900, fn: () => show(thought, "Blocked. Merging is not in my policy.") },
      { t: 14000, fn: () => hide(thought) },
      {
        t: 14300,
        fn: () => {
          face("idle");
          show(sayAgent, "I need your approval to merge this.");
        },
      },
      { t: 15200, fn: () => (lns[3]!.dataset.caret = "true") },
      {
        t: 16200,
        fn: () => {
          act("3");
          focus("human");
        },
      },
      { t: 16700, fn: () => phone.classList.add("is-in") },
      { t: 17300, fn: () => tg.classList.add("is-in") },
      {
        t: 19600,
        fn: () => {
          hide(sayAgent);
          show(sayHuman, "Looks right. Approving.");
        },
      },
      {
        t: 21800,
        fn: () => {
          actions.hidden = true;
          tgok.hidden = false;
          face("wink");
        },
      },
      {
        t: 23000,
        fn: () => {
          hide(sayHuman);
          act("4");
          focus("agent");
          face("think");
          phone.classList.remove("is-in");
          delete lns[3]!.dataset.caret;
        },
      },
      { t: 23800, fn: () => line(4) },
      {
        t: 24700,
        fn: () => {
          line(5);
          face("happy");
        },
      },
      {
        t: 25400,
        fn: () => {
          dots.classList.remove("is-on");
          show(sayAgent, "Merged.");
        },
      },
    ];

    const APPROVE_AT = 21800;

    /** Everything a cue can set has to be cleared here. See lib/scene.ts. */
    function reset() {
      act("0");
      focus("none");
      face("idle");
      [sayHuman, sayAgent, thought].forEach(hide);
      dots.classList.remove("is-on");
      term.classList.remove("is-in");
      lns.forEach((l) => {
        l.classList.remove("is-in");
        delete l.dataset.caret;
      });
      phone.classList.remove("is-in");
      tg.classList.remove("is-in");
      actions.hidden = false;
      tgok.hidden = true;
    }

    const scene = createScene({
      root: theater,
      stage,
      cues: CUES,
      durationMs: 28200,
      reset,
      toggle,
      seek,
      rate,
    });

    // Tapping Approve early jumps the clock to the decision.
    approve.addEventListener("click", () => {
      ripple.classList.remove("is-tap");
      void ripple.offsetWidth;
      ripple.classList.add("is-tap");
      if (scene.time() < APPROVE_AT) scene.seekTo(APPROVE_AT);
    });
  }
</script>
