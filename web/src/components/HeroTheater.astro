---
/**
 * The hero's right pane, staged as a play with a scrubbable timeline.
 *
 * Act 1  the two characters walk on and talk
 * Act 2  the agent takes its desk, works, and its first merge is refused
 * Act 3  it asks instead; the phone comes out and the operator approves
 * Act 4  the operation resumes and the merge lands
 *
 * The scene is a list of cues on a clock rather than a sequential script, so
 * any point is reachable: seeking replays every cue up to that time with
 * transitions suppressed, then playback resumes from there. Every cue sets
 * state outright, which is what makes replaying a prefix idempotent.
 *
 * The agent has two kinds of bubble. Speech is what it says to you; thought is
 * what it is working through on its own, and reads differently.
 */
import { isoDefs, isoStopCss, personIcon, agentIcon } from "../lib/iso";

const P = "th";

const lines = [
  { text: "$ gh-broker operation submit pull_request.create" },
  { text: "op_9c2f  succeeded  pull request #482 opened", tone: "ok" },
  { text: "$ gh-broker operation submit pull_request.merge" },
  { text: "op_1d55  failed     required review not satisfied", tone: "bad" },
  { text: "$ gh-broker operation submit pull_request.merge_admin" },
  { text: "op_4a71  pending    approval required", tone: "warn" },
  { text: "op_4a71  approved   by operator, single use", tone: "ok" },
  { text: "op_4a71  succeeded  pull request #482 merged", tone: "ok" },
];
---

<div class="theater">
  <div class="stagewrap">
    <div class="stage" data-stage data-act="0">
      <svg class="stage__defs" aria-hidden="true" focusable="false">
        <defs set:html={isoDefs(P)} />
      </svg>

      <div class="actor actor--human">
        <svg class="actor__art" viewBox="-34 -50 68 92" set:html={personIcon(P)} />
        <span class="actor__name">YOU</span>
      </div>

      <div class="actor actor--agent">
        <svg class="actor__art" viewBox="-38 -52 76 96" set:html={agentIcon(P)} />
        <span class="actor__name">AGENT</span>
        <span class="dots" data-dots aria-hidden="true"><i></i><i></i><i></i></span>
      </div>

      <p class="say say--human" data-say-human></p>
      <p class="say say--agent" data-say-agent></p>
      <p class="say say--think" data-thought></p>

      <div class="term" data-term>
        <div class="term__bar">agent-a@workstation</div>
        <pre class="term__body"><code>{
          lines.map((l, i) => (
            <span class="ln" data-ln={i} data-tone={l.tone ?? "plain"}>{l.text}</span>
          ))
        }</code></pre>
      </div>

      <div class="phone" data-phone>
        <div class="tgbar">
          <span class="tgbar__back">‹</span>
          <span class="tgbar__ava">u</span>
          <span class="tgbar__who"><b>unYOLO</b><i>bot</i></span>
        </div>
        <div class="tgchat">
          <div class="tgmsg" data-tg>
            <p class="tgmsg__from">unYOLO</p>
            <p class="tgmsg__title">Approval required</p>
            <p class="tgmsg__body">
              <b>agent-a</b> wants to merge <b>#482</b> in <b>acme/api</b>.
            </p>
            <p class="tgmsg__warn">Bypasses the required review on main.</p>
            <span class="tgmsg__time">09:41</span>
            <div class="tgkb" data-actions>
              <button class="tgkb__btn" type="button" data-approve>
                Approve · 1 use
                <span class="ripple" data-ripple></span>
              </button>
              <button class="tgkb__btn" type="button" disabled>Deny</button>
            </div>
            <div class="tgkb tgkb--done" data-tgok hidden>
              <span class="tgkb__done">✓ Approved by you</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="ctl">
    <button class="ctl__btn" type="button" data-toggle aria-label="Pause">
      <svg class="ctl__pause" viewBox="0 0 12 12" aria-hidden="true"
        ><rect x="2" y="1.5" width="3" height="9" rx="1"></rect><rect x="7" y="1.5" width="3" height="9" rx="1"
        ></rect></svg
      >
      <svg class="ctl__play" viewBox="0 0 12 12" aria-hidden="true"
        ><path d="M3 1.5 L10.5 6 L3 10.5 Z"></path></svg
      >
    </button>
    <input
      class="ctl__seek"
      type="range"
      min="0"
      max="1000"
      value="0"
      step="1"
      data-seek
      aria-label="Scrub the scene"
    />
  </div>
</div>

<style set:html={isoStopCss}></style>

<style>
  .theater {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .stagewrap {
    height: 520px;
    overflow: hidden;
  }

  .stage {
    position: relative;
    width: 520px;
    height: 520px;
    transform-origin: top left;
  }

  /* Applied while seeking, so a jump lands instantly instead of sliding. */
  .stage.is-seeking,
  .stage.is-seeking * {
    transition: none !important;
  }

  .stage__defs {
    position: absolute;
    width: 0;
    height: 0;
  }

  /* ---------------------------------------------------------------- iso -- */

  .actor__art :global(.iso-mark) {
    fill: var(--iso-mark);
  }
  .actor__art :global(.iso-shadow) {
    fill: var(--iso-shadow);
  }
  .actor__art :global(.iso-screen) {
    fill: var(--iso-screen);
  }
  .actor__art :global(.iso-eye) {
    fill: var(--iso-eye);
  }
  .actor__art :global(.iso-antenna) {
    stroke: var(--iso-mark);
    stroke-width: 2;
    stroke-linecap: round;
  }

  /* -------------------------------------------------------------- actors -- */

  .actor {
    position: absolute;
    z-index: 2;
    left: 50%;
    top: 50%;
    width: 120px;
    margin: -70px 0 0 -60px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.1rem;
    transform: translate(var(--x, 0), var(--y, 0)) scale(var(--s, 1));
    opacity: var(--o, 0);
    transition:
      transform 760ms cubic-bezier(0.5, 0, 0.2, 1),
      opacity 460ms ease;
  }

  .actor__art {
    width: 100px;
    height: auto;
    overflow: visible;
  }

  .actor__name {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--text-faint);
  }

  .stage[data-act="0"] .actor--human {
    --x: -230px;
    --y: 60px;
    --o: 0;
  }
  .stage[data-act="0"] .actor--agent {
    --x: 230px;
    --y: 60px;
    --o: 0;
  }

  .stage[data-act="1"] .actor--human,
  .stage[data-act="1"] .actor--agent {
    --o: 1;
    --y: 60px;
  }
  .stage[data-act="1"] .actor--human {
    --x: -110px;
  }
  .stage[data-act="1"] .actor--agent {
    --x: 110px;
  }

  .stage[data-act="2"] .actor--agent,
  .stage[data-act="3"] .actor--agent,
  .stage[data-act="4"] .actor--agent {
    --o: 1;
    --x: -196px;
    --y: -186px;
    --s: 0.6;
  }
  .stage[data-act="2"] .actor--human,
  .stage[data-act="4"] .actor--human {
    --o: 1;
    --x: -196px;
    --y: 150px;
    --s: 0.6;
  }
  .stage[data-act="3"] .actor--human {
    --o: 1;
    --x: -198px;
    --y: 144px;
    --s: 0.74;
  }

  /* ---------------------------------------------------------------- dots -- */

  .dots {
    position: absolute;
    top: -2px;
    right: 4px;
    display: flex;
    gap: 3px;
    padding: 4px 6px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
    opacity: 0;
    transform: scale(0.7);
    transition: opacity 220ms ease, transform 260ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .dots.is-on {
    opacity: 1;
    transform: none;
  }

  .dots i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--text-faint);
    animation: bob 1.15s ease-in-out infinite;
  }
  .dots i:nth-child(2) {
    animation-delay: 0.16s;
  }
  .dots i:nth-child(3) {
    animation-delay: 0.32s;
  }

  @keyframes bob {
    0%,
    70%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    35% {
      transform: translateY(-3px);
      opacity: 1;
    }
  }

  /* ------------------------------------------------------ speech, thought -- */

  .say {
    position: absolute;
    z-index: 4;
    left: 50%;
    top: 50%;
    width: max-content;
    max-width: 194px;
    margin: 0;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--bg-inset);
    font-size: 0.875rem;
    line-height: 1.4;
    color: var(--text);
    box-shadow: var(--shadow-sm);
    opacity: 0;
    transform: translate(var(--sx), var(--sy)) translateY(10px) scale(0.94);
    transition: opacity 240ms ease, transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
    pointer-events: none;
  }

  .say.is-in {
    opacity: 1;
    transform: translate(var(--sx), var(--sy));
  }

  .say--human {
    --sx: -246px;
    --sy: -84px;
    border-bottom-left-radius: 3px;
    transform-origin: 0 100%;
  }

  .say--agent {
    --sx: 46px;
    --sy: -84px;
    border-bottom-right-radius: 3px;
    background: var(--bg-subtle);
    transform-origin: 100% 100%;
  }

  .stage[data-act="2"] .say--agent,
  .stage[data-act="3"] .say--agent,
  .stage[data-act="4"] .say--agent {
    --sx: -116px;
    --sy: -232px;
  }

  /* Narrower here so it does not run under the phone standing beside it. */
  .stage[data-act="3"] .say--human {
    --sx: -252px;
    --sy: 8px;
    max-width: 132px;
  }

  /* A thought reads as internal: dashed, italic, quieter, with a cloud tail. */
  .say--think {
    --sx: -116px;
    --sy: -232px;
    max-width: 200px;
    border-style: dashed;
    border-radius: 15px;
    background: var(--bg);
    font-style: italic;
    font-size: 0.8125rem;
    color: var(--text-muted);
    box-shadow: none;
    transform-origin: 0 100%;
  }

  .say--think::before,
  .say--think::after {
    content: "";
    position: absolute;
    border: 1px dashed var(--border);
    border-radius: 50%;
    background: var(--bg);
  }

  .say--think::before {
    left: 10px;
    bottom: -9px;
    width: 8px;
    height: 8px;
  }

  .say--think::after {
    left: 2px;
    bottom: -17px;
    width: 5px;
    height: 5px;
  }

  /* ------------------------------------------------------------ terminal -- */

  .term {
    position: absolute;
    z-index: 1;
    left: 112px;
    top: 92px;
    right: 6px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
    box-shadow: var(--shadow-md);
    opacity: 0;
    transform: translateY(18px) scale(0.97);
    transform-origin: 0 0;
    transition: opacity 340ms ease, transform 520ms cubic-bezier(0.22, 1, 0.36, 1);
    pointer-events: none;
  }

  .term.is-in {
    opacity: 1;
    transform: none;
  }

  .term__bar {
    padding: 0.35rem 0.7rem;
    border-bottom: 1px solid var(--border);
    background: var(--bg-subtle);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-faint);
  }

  .term__body {
    margin: 0;
    padding: 0.6rem 0.75rem;
    min-height: 11.1rem;
    overflow-x: auto;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    line-height: 1.85;
    color: var(--text);
  }

  .ln {
    display: block;
    white-space: pre;
    opacity: 0;
    transform: translateY(6px);
  }

  .ln.is-in {
    opacity: 1;
    transform: none;
    transition: opacity 240ms ease, transform 300ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  .ln[data-tone="ok"] {
    color: #2f7a4d;
  }
  .ln[data-tone="warn"] {
    color: #97690e;
  }
  .ln[data-tone="bad"] {
    color: #b4383f;
  }

  html[data-theme="dark"] .ln[data-tone="ok"] {
    color: #7fc79b;
  }
  html[data-theme="dark"] .ln[data-tone="warn"] {
    color: #d4b071;
  }
  html[data-theme="dark"] .ln[data-tone="bad"] {
    color: #ef9296;
  }

  .ln[data-caret="true"]::after {
    content: "▋";
    margin-left: 0.15rem;
    animation: blink 1.05s steps(1, end) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  /* --------------------------------------------------------------- phone -- */
  /* Telegram's own palette, so the approval reads as the app it arrives in. */

  :global([data-theme="dark"]) .phone {
    --tg-bezel: #444b54;
  }

  .phone {
    --tg-header: #527da3;
    --tg-chat: #dfe6ec;
    --tg-bubble: #ffffff;
    --tg-text: #16191c;
    --tg-blue: #2f81d6;
    --tg-muted: #7d8e9c;
    --tg-rule: #e3e9ee;
    --tg-bezel: #1b2025;

    position: absolute;
    z-index: 3;
    left: 50%;
    top: 50%;
    width: 224px;
    margin: -118px 0 0 -109px;
    border: 6px solid var(--tg-bezel);
    border-radius: 20px;
    background: var(--tg-chat);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
    opacity: 0;
    transform: translate(-2px, 290px) scale(0.9) rotate(5deg);
    transition: opacity 320ms ease, transform 640ms cubic-bezier(0.34, 1.4, 0.5, 1);
    pointer-events: none;
  }

  .phone.is-in {
    opacity: 1;
    transform: translate(-2px, 108px) scale(1) rotate(0deg);
    pointer-events: auto;
  }

  .tgbar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.55rem;
    background: var(--tg-header);
    color: #fff;
  }

  .tgbar__back {
    font-size: 1rem;
    line-height: 1;
    opacity: 0.9;
  }

  .tgbar__ava {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: #74a9d4;
    font-size: 0.6875rem;
    font-weight: 700;
  }

  .tgbar__who {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }

  .tgbar__who b {
    font-size: 0.75rem;
    font-weight: 600;
  }

  .tgbar__who i {
    font-size: 0.625rem;
    font-style: normal;
    opacity: 0.78;
  }

  .tgchat {
    padding: 0.55rem 0.5rem 0.65rem;
    min-height: 170px;
  }

  .tgmsg {
    position: relative;
    max-width: 97%;
    padding: 0.4rem 0.5rem 0.3rem;
    border-radius: 10px 10px 10px 3px;
    background: var(--tg-bubble);
    box-shadow: 0 1px 1px rgb(16 35 47 / 0.16);
    color: var(--tg-text);
    opacity: 0;
    transform: translateY(10px) scale(0.95);
    transform-origin: 0 100%;
  }

  .tgmsg.is-in {
    opacity: 1;
    transform: none;
    transition: opacity 240ms ease, transform 400ms cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .tgmsg__from {
    margin: 0 0 0.1rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: var(--tg-blue);
  }

  .tgmsg__title {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 700;
  }

  .tgmsg__body {
    margin: 0.15rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.4;
  }

  .tgmsg__warn {
    margin: 0.2rem 0 0;
    font-size: 0.6875rem;
    line-height: 1.35;
    color: #b4383f;
  }

  .tgmsg__time {
    display: block;
    margin-top: 0.1rem;
    text-align: right;
    font-size: 0.5625rem;
    color: var(--tg-muted);
  }

  /* Telegram inline keyboard: attached under the bubble, blue labels. */
  .tgkb {
    display: flex;
    margin: 0.3rem -0.5rem -0.3rem;
    border-top: 1px solid var(--tg-rule);
  }

  .tgkb__btn {
    position: relative;
    flex: 1;
    padding: 0.4rem 0.3rem;
    border: 0;
    background: transparent;
    color: var(--tg-blue);
    font-family: inherit;
    font-size: 0.6875rem;
    font-weight: 600;
    cursor: pointer;
    overflow: hidden;
  }

  .tgkb__btn + .tgkb__btn {
    border-left: 1px solid var(--tg-rule);
  }

  .tgkb__btn:hover:not(:disabled) {
    background: #f1f6fa;
  }

  .tgkb__btn[disabled] {
    color: var(--tg-muted);
    cursor: default;
  }

  .tgkb[hidden] {
    display: none;
  }

  .tgkb--done {
    justify-content: center;
  }

  .tgkb__done {
    padding: 0.4rem 0.3rem;
    font-size: 0.6875rem;
    font-weight: 700;
    color: #2f7a4d;
    animation: rise 320ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
  }

  .ripple {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 8px;
    height: 8px;
    margin: -4px 0 0 -4px;
    border-radius: 50%;
    background: var(--tg-blue);
    opacity: 0;
    pointer-events: none;
  }

  .ripple.is-tap {
    animation: tap 520ms ease-out;
  }

  @keyframes tap {
    from {
      opacity: 0.4;
      transform: scale(1);
    }
    to {
      opacity: 0;
      transform: scale(18);
    }
  }

  /* ----------------------------------------------------------- transport -- */

  .ctl {
    display: flex;
    align-items: center;
    gap: 0.6rem;
  }

  .ctl__btn {
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    padding: 0;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
    background: var(--bg);
    color: var(--text-muted);
    cursor: pointer;
    flex-shrink: 0;
  }

  .ctl__btn:hover {
    color: var(--text-strong);
  }

  .ctl__btn svg {
    width: 10px;
    height: 10px;
    fill: currentColor;
  }

  .ctl__play {
    display: none;
  }

  .theater[data-paused="true"] .ctl__pause {
    display: none;
  }
  .theater[data-paused="true"] .ctl__play {
    display: block;
  }

  .ctl__seek {
    flex: 1;
    height: 4px;
    margin: 0;
    appearance: none;
    -webkit-appearance: none;
    background: var(--border);
    border-radius: 999px;
    cursor: pointer;
  }

  .ctl__seek::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: var(--solid);
  }

  .ctl__seek::-moz-range-thumb {
    width: 11px;
    height: 11px;
    border: 0;
    border-radius: 50%;
    background: var(--solid);
  }

  @media (max-width: 40rem) {
    .stagewrap {
      height: 405px;
    }
    .stage {
      transform: scale(0.78);
    }
  }
</style>

<script>
  const theater = document.querySelector<HTMLElement>(".theater");
  const stage = theater?.querySelector<HTMLElement>("[data-stage]");

  if (theater && stage) {
    const sayHuman = stage.querySelector<HTMLElement>("[data-say-human]")!;
    const sayAgent = stage.querySelector<HTMLElement>("[data-say-agent]")!;
    const thought = stage.querySelector<HTMLElement>("[data-thought]")!;
    const dots = stage.querySelector<HTMLElement>("[data-dots]")!;
    const term = stage.querySelector<HTMLElement>("[data-term]")!;
    const lns = [...stage.querySelectorAll<HTMLElement>("[data-ln]")];
    const phone = stage.querySelector<HTMLElement>("[data-phone]")!;
    const tg = stage.querySelector<HTMLElement>("[data-tg]")!;
    const actions = stage.querySelector<HTMLElement>("[data-actions]")!;
    const tgok = stage.querySelector<HTMLElement>("[data-tgok]")!;
    const approve = stage.querySelector<HTMLButtonElement>("[data-approve]")!;
    const ripple = stage.querySelector<HTMLElement>("[data-ripple]")!;
    const toggle = theater.querySelector<HTMLButtonElement>("[data-toggle]")!;
    const seek = theater.querySelector<HTMLInputElement>("[data-seek]")!;

    const act = (n: string) => (stage.dataset.act = n);
    const show = (el: HTMLElement, text: string) => {
      el.textContent = text;
      el.classList.add("is-in");
    };
    const hide = (el: HTMLElement) => el.classList.remove("is-in");
    const line = (i: number) => lns[i]!.classList.add("is-in");

    const CUES: { t: number; fn: () => void }[] = [
      { t: 250, fn: () => act("1") },
      { t: 1400, fn: () => show(sayHuman, "Ship the parser fix and merge it.") },
      { t: 3800, fn: () => hide(sayHuman) },
      { t: 4200, fn: () => show(sayAgent, "On it. Let me open a PR first.") },
      { t: 6300, fn: () => hide(sayAgent) },
      { t: 6700, fn: () => act("2") },
      {
        t: 7400,
        fn: () => {
          dots.classList.add("is-on");
          term.classList.add("is-in");
        },
      },
      { t: 7800, fn: () => show(thought, "Opening the pull request…") },
      { t: 8300, fn: () => line(0) },
      { t: 9100, fn: () => line(1) },
      { t: 9800, fn: () => hide(thought) },
      { t: 10000, fn: () => show(thought, "Now merging it.") },
      { t: 10400, fn: () => line(2) },
      { t: 11200, fn: () => line(3) },
      { t: 11600, fn: () => hide(thought) },
      { t: 11900, fn: () => show(thought, "Refused. main requires a review.") },
      { t: 14000, fn: () => hide(thought) },
      { t: 14300, fn: () => show(sayAgent, "I need your approval to merge this.") },
      { t: 14600, fn: () => line(4) },
      {
        t: 15500,
        fn: () => {
          line(5);
          lns[5]!.dataset.caret = "true";
        },
      },
      { t: 16200, fn: () => act("3") },
      { t: 16700, fn: () => phone.classList.add("is-in") },
      { t: 17300, fn: () => tg.classList.add("is-in") },
      {
        t: 19600,
        fn: () => {
          hide(sayAgent);
          show(sayHuman, "Looks right. Approving.");
        },
      },
      {
        t: 21800,
        fn: () => {
          actions.hidden = true;
          tgok.hidden = false;
        },
      },
      {
        t: 23000,
        fn: () => {
          hide(sayHuman);
          act("4");
          phone.classList.remove("is-in");
          delete lns[5]!.dataset.caret;
        },
      },
      { t: 23800, fn: () => line(6) },
      { t: 24700, fn: () => line(7) },
      {
        t: 25400,
        fn: () => {
          dots.classList.remove("is-on");
          show(sayAgent, "Merged.");
        },
      },
    ];

    const APPROVE_AT = 21800;
    const DURATION = 28200;

    function clear() {
      act("0");
      [sayHuman, sayAgent, thought].forEach(hide);
      dots.classList.remove("is-on");
      term.classList.remove("is-in");
      lns.forEach((l) => {
        l.classList.remove("is-in");
        delete l.dataset.caret;
      });
      phone.classList.remove("is-in");
      tg.classList.remove("is-in");
      actions.hidden = false;
      tgok.hidden = true;
    }

    let t = 0;
    let cursor = 0;
    let playing = false;
    let last = 0;

    /** Jump anywhere: rebuild state from scratch without animating the jump. */
    function goto(target: number) {
      t = Math.max(0, Math.min(DURATION, target));
      stage!.classList.add("is-seeking");
      clear();
      cursor = 0;
      while (cursor < CUES.length && CUES[cursor]!.t <= t) CUES[cursor++]!.fn();
      // Commit the suppressed styles before transitions come back on.
      void stage!.offsetWidth;
      stage!.classList.remove("is-seeking");
      seek.value = String(Math.round((t / DURATION) * 1000));
    }

    function frame(now: number) {
      if (playing) {
        // Clamp the step so a backgrounded tab does not skip the whole scene.
        t += last ? Math.min(now - last, 120) : 0;
        if (t >= DURATION) {
          goto(0);
        } else {
          while (cursor < CUES.length && CUES[cursor]!.t <= t) CUES[cursor++]!.fn();
          seek.value = String(Math.round((t / DURATION) * 1000));
        }
      }
      last = now;
      requestAnimationFrame(frame);
    }

    function setPlaying(on: boolean) {
      playing = on;
      last = 0;
      theater!.dataset.paused = String(!on);
      toggle.setAttribute("aria-label", on ? "Pause" : "Play");
    }

    toggle.addEventListener("click", () => setPlaying(!playing));
    seek.addEventListener("input", () => goto((Number(seek.value) / 1000) * DURATION));

    // Tapping Approve early jumps the clock to the decision.
    approve.addEventListener("click", () => {
      ripple.classList.remove("is-tap");
      void ripple.offsetWidth;
      ripple.classList.add("is-tap");
      if (t < APPROVE_AT) goto(APPROVE_AT);
    });

    goto(0);
    setPlaying(false);
    requestAnimationFrame(frame);

    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          setPlaying(true);
        }
      },
      { threshold: 0.3 },
    );
    io.observe(stage);
  }
</script>
