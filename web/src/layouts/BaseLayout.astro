---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchDialog from "../components/SearchDialog.astro";

interface Props {
  title: string;
  description: string;
  /** Adds the docs-shell class hooks and marks the Docs nav item active. */
  section?: "home" | "docs";
}

const { title, description, section = "docs" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://unyolo.io");
const fullTitle = title === "unYOLO" ? title : `${title} · unYOLO`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Applied before first paint so a dark-theme reader never sees a flash.
      (function () {
        try {
          var stored = localStorage.getItem("unyolo-theme");
          var prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
          document.documentElement.dataset.theme =
            stored === "light" || stored === "dark" ? stored : prefersDark ? "dark" : "light";
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header section={section} />
    <slot />
    <Footer />
    <SearchDialog />

    <script>
      // Theme toggle. Persisted per browser; the inline head script reads it back.
      const root = document.documentElement;
      document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((button) => {
        button.addEventListener("click", () => {
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try {
            localStorage.setItem("unyolo-theme", next);
          } catch {
            /* private mode: the choice simply does not persist */
          }
        });
      });
    </script>

    <script>
      // Copy buttons for code blocks, added client-side so the markup stays clean.
      const label = (text: string) => {
        const span = document.createElement("span");
        span.textContent = text;
        return span;
      };

      document.querySelectorAll<HTMLPreElement>(".prose pre").forEach((pre) => {
        const wrapper = document.createElement("div");
        wrapper.className = "code-block";
        pre.parentNode?.insertBefore(wrapper, pre);
        wrapper.appendChild(pre);

        const button = document.createElement("button");
        button.type = "button";
        button.className = "copy-button";
        button.setAttribute("aria-label", "Copy code to clipboard");
        button.appendChild(label("Copy"));
        wrapper.appendChild(button);

        button.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(pre.innerText);
            button.dataset.copied = "true";
            button.replaceChildren(label("Copied"));
            setTimeout(() => {
              delete button.dataset.copied;
              button.replaceChildren(label("Copy"));
            }, 1600);
          } catch {
            button.replaceChildren(label("Press Ctrl+C"));
          }
        });
      });
    </script>
  </body>
</html>
