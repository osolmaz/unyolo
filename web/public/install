#!/bin/sh
#
# unYOLO broker installer, served from https://unyolo.io/install
#
#   curl -fsSL https://unyolo.io/install | sh -s github
#
# This fetches the named broker's bootstrap from GitHub and runs it. The
# bootstrap resolves the broker's latest release to an exact commit, then
# verifies release checksums and GitHub build attestations before anything is
# installed, so the download is checked whichever entry point you use.
#
# What this endpoint does not do is pin itself. It serves whatever is on the
# default branch. Set UNYOLO_REV to a commit you have reviewed to pin the
# bootstrap too:
#
#   curl -fsSL https://unyolo.io/install | UNYOLO_REV=<40-char-sha> sh -s github
#
set -eu

REPO="${REPO:-osolmaz/unyolo}"
REV="${UNYOLO_REV:-main}"
RAW_BASE="${UNYOLO_RAW_URL_BASE:-https://raw.githubusercontent.com/${REPO}}"
BROKER="${1:-}"

usage="usage: curl -fsSL https://unyolo.io/install | sh -s <github|huggingface|sudo>"

# Kept in step with the brokers/ directory by TestWebInstallEndpointListsEveryBroker.
case "$BROKER" in
  github | huggingface | sudo) ;;
  "")
    echo "unyolo install: name a broker" >&2
    echo "$usage" >&2
    exit 1
    ;;
  *)
    echo "unyolo install: unknown broker '$BROKER'" >&2
    echo "$usage" >&2
    exit 1
    ;;
esac

command -v curl >/dev/null 2>&1 || {
  echo "unyolo install: missing required command: curl" >&2
  exit 1
}

curl -fsSL "${RAW_BASE}/${REV}/brokers/${BROKER}/install.sh" | sh
