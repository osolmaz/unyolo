{
  "name": "openclaw-unyolo",
  "version": "0.5.1",
  "description": "Provider-neutral unYOLO approvals for OpenClaw",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osolmaz/unyolo.git",
    "directory": "plugins/openclaw"
  },
  "homepage": "https://github.com/osolmaz/unyolo/tree/main/plugins/openclaw#readme",
  "bugs": {
    "url": "https://github.com/osolmaz/unyolo/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    },
    "./operator-v1": {
      "types": "./dist/src/operator-v1.d.ts",
      "import": "./dist/src/operator-v1.js"
    }
  },
  "scripts": {
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json && tsc -p tsconfig.operator-contract.json && pnpm run stage:skills",
    "check": "pnpm run generate:check && pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "test:package": "node scripts/test-packed-install.mjs",
    "generate": "../../scripts/generate-protocol.sh",
    "generate:check": "../../scripts/check-protocol.sh && node scripts/generate-redaction-fixture.mjs --check",
    "generate:redaction-fixture": "node scripts/generate-redaction-fixture.mjs",
    "stage:skills": "node scripts/stage-skills.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1"
  },
  "peerDependenciesMeta": {
    "openclaw": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.1.11",
    "@testing-library/react": "16.3.2",
    "@types/node": "24.0.13",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "jsdom": "29.1.1",
    "openclaw": "2026.7.1",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "typescript-eslint": "8.37.0",
    "vite": "7.0.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.14",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.525.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.0",
    "zod": "4.0.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "openclaw-unyolo",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.1"
    },
    "compat": {
      "pluginApi": ">=2026.7.1"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
