{
  "name": "openclaw-brokerkit",
  "version": "0.1.0",
  "description": "Provider-neutral BrokerKit approvals for OpenClaw",
  "type": "module",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "pnpm run clean && vite build && tsc -p tsconfig.build.json",
    "check": "pnpm run generate:check && pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "clean": "rm -rf dist",
    "test": "vitest run --config vitest.config.ts",
    "test:browser": "playwright test",
    "test:package": "node scripts/test-packed-install.mjs",
    "generate": "node scripts/generate-operator-v1.mjs",
    "generate:check": "node scripts/generate-operator-v1.mjs --check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "peerDependencies": {
    "openclaw": ">=2026.7.1-beta.5"
  },
  "devDependencies": {
    "@eslint/js": "9.31.0",
    "@playwright/test": "1.61.1",
    "@tailwindcss/vite": "4.1.11",
    "@types/node": "24.0.13",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "@vitejs/plugin-react": "4.6.0",
    "eslint": "9.31.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "openclaw": "2026.7.1-beta.5",
    "prettier": "3.6.2",
    "tailwindcss": "4.1.11",
    "typescript": "5.8.3",
    "typescript-eslint": "8.37.0",
    "vite": "7.0.4",
    "vitest": "3.2.4"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.525.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "tailwind-merge": "3.3.0",
    "zod": "4.0.5"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "install": {
      "npmSpec": "openclaw-brokerkit",
      "defaultChoice": "npm",
      "minHostVersion": ">=2026.7.1-beta.5"
    },
    "compat": {
      "pluginApi": ">=2026.7.1-beta.5"
    },
    "release": {
      "publishToClawHub": true,
      "publishToNpm": true
    }
  }
}
