{
  "id": "brokerkit",
  "activation": { "onStartup": true },
  "name": "BrokerKit",
  "description": "Provider-neutral approval inbox for BrokerKit sources.",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "$defs": {
      "secretRef": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": { "enum": ["env", "file", "exec"] },
          "provider": { "type": "string", "minLength": 1, "maxLength": 64 },
          "id": { "type": "string", "minLength": 1, "maxLength": 512 }
        },
        "required": ["source", "provider", "id"]
      },
      "broker": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "endpoint": {
            "type": "string",
            "format": "uri",
            "pattern": "^https?://",
            "not": { "pattern": "[?#]" }
          },
          "operatorCredential": { "$ref": "#/$defs/secretRef" },
          "requestTimeoutMs": {
            "type": "integer",
            "minimum": 1000,
            "maximum": 60000
          }
        },
        "required": ["id", "label", "endpoint", "operatorCredential"]
      }
    },
    "properties": {
      "brokers": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": { "$ref": "#/$defs/broker" }
      },
      "pollIntervalMs": {
        "type": "integer",
        "minimum": 5000,
        "maximum": 300000
      },
      "notificationConcurrency": {
        "type": "integer",
        "minimum": 1,
        "maximum": 16
      }
    },
    "required": ["brokers"]
  }
}
